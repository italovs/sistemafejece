<!DOCTYPE html>

	<html lang="pt-BR">

		<head>
			<meta charset="UTF-8">
			<%= csrf_meta_tags %>
			<!-- ===== Mobile viewport optimized ===== -->
			<meta http-equiv="X-UA-Compatible" content="IE=edge">
			<meta name="viewport" content="width=device-width, initial-scale=1.0,maximum-scale=1.0, user-scalable=no">

			<!-- ===== Meta Tags - Description for Search Engine purposes ===== -->
			<meta name="description" content="Movify - Movies, Series & Cinema HTML Template">
			<meta name="keywords" content="movies, series, online streaming, html template, cinema html template">
			<meta name="author" content="GnoDesign">
			<meta name="turbolinks-visit-control" content="reload">

			<!-- ===== Website Title ===== -->
			<title>Farol</title>

			<%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
				<%= stylesheet_link_tag 'application', media: 'all' %>

			<!-- ===== Favicon & Different size apple touch icons ===== -->
			<link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon">
			<link rel="apple-touch-icon" sizes="57x57" href="assets/images/apple-touch-icon-iphone.png">
			<link rel="apple-touch-icon" sizes="76x76" href="assets/images/apple-touch-icon-ipad.png">
			<link rel="apple-touch-icon" sizes="120x120" href="assets/images/apple-touch-icon-iphone-retina.png">
			<link rel="apple-touch-icon" sizes="152x152" href="assets/images/apple-touch-icon-ipad-retina.png">
			<link rel="apple-touch-icon" sizes="167x167" href="assets/images/apple-touch-icon-ipad-pro.png">
			<link rel="apple-touch-icon" sizes="180x180" href="assets/images/apple-touch-icon-iphone-6-plus.png">
			<link rel="icon" sizes="192x192" href="assets/images/icon-hd.png">
			<link rel="icon" sizes="128x128" href="assets/images/icon.png">

			<!-- ===== Google Fonts ===== -->
			<link href="https://fonts.googleapis.com/css?family=Quicksand:300,400,500,700" rel="stylesheet">
			<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
			<link href="https://use.fontawesome.com/releases/v5.15.2/css/all.css" rel="stylesheet">
				

			<!-- ===== CSS links ===== -->
			<%= stylesheet_link_tag 'application', media: 'all' %>
			<%= stylesheet_link_tag 'bootstrap.min', media: 'all' %>
			<%= stylesheet_link_tag 'revolution/css/settings', media: 'all' %>
			<%= stylesheet_link_tag 'revolution/css/layers', media: 'all' %>
			<%= stylesheet_link_tag 'revolution/css/navigation', media: 'all' %>
			<%= stylesheet_link_tag 'magnific-popup', media: 'all' %>
			<%= stylesheet_link_tag 'jquery.mmenu', media: 'all' %>
			<%= stylesheet_link_tag 'owl.carousel.min', media: 'all' %>
			<%= stylesheet_link_tag 'style', media: 'all' %>
			<%= stylesheet_link_tag 'responsive', media: 'all' %>
		</head>

		<style>

			.mm-slideout{
				z-index: 9999;
			}

			#main-mobile-nav{
				z-index: 9999;
			}

			.header{
				background: trasnparent !important;
			}

			.overlay-gradient .slotholder:after,
			.overlay-gradient:after {
				opacity:0.6 !important;
			}

			a:visited {
				color: #fff; }

			.overlay-gradient .slotholder:after,
			.overlay-gradient:after,
			.blog-post .blog-thumb a:before,
			ul.blog-posts-widget .blog-content .blog-thumb a:before,
			.celebrity-list-1 .celebrity-image a:before,
			.celebrity-grid-1 .celebrity-image a:before,
			.bloglist-post-holder .bloglist-thumb-link .bloglist-post-thumbnail:after,
			.movie-box-1 .poster:before,
			.movie-detail-intro2 .movie-poster:before {
					background: -webkit-gradient(linear, left top, left bottom, from(#018c77), to(#e27321));
					background: -webkit-linear-gradient(bottom, #e27321 20%, #018c77 100%);
					background: -o-linear-gradient(bottom, #e27321 20%, #018c77 100%);
					background: linear-gradient(to bottom, #018c77 20%, #e27321 100%);
			}
		</style>


		<body>
			<nav id="main-mobile-nav"></nav>
			<%= render '/layouts/member_navbar' %>
			<%= yield %>
			
			<!-- =============== START OF MOVIE DETAIL INTRO =============== -->
			<% if @post.banner_image.attached? %>      
				<section  class="movie-detail-intro overlay-gradient ptb100" style="height:650px; background-image: url(<%= rails_blob_url(@post.banner_image) %>);">
				</section>
			<% else %>
				<section  class="movie-detail-intro overlay-gradient ptb100" style="height:650px;">
				</section>
			<% end %>	
			<!-- =============== END OF MOVIE DETAIL INTRO =============== -->



			<!-- =============== START OF MOVIE DETAIL INTRO 2 =============== -->
			<section class="movie-detail-intro2">
					<div class="container">
							<div class="row">
									<div class="col-md-12">

											<div class="movie-poster">
													<%if @post.poster_image.attached?%>
														<%= image_tag @post.poster_image.variant(gravity:'Center',resize:"300x444^"  , crop: '300x444+0+0')%>
													<%end%>
													<div class ="buttons">
														<% if @post.kind == 'video'%>
															<a class="play-video" href="https://www.youtube.com/watch?v=<%= @post.link%>" id="<%= @post.id %>">
																<i class="fas fa-play"></i>
															</a>
														<% elsif @post.kind == 'post'%>
															<a class="open-post" target="_blank" href="<%= @post.link%>" id="<%= @post.id %>">
																<i class="fas fa-link"></i>
															</a>
														<% end %>
													</div>
											</div>


											<div class="movie-details">
													<h3 class="title mb-2"><%= @post.name %></h3>
													
                                  					<div class="category text-white mb-3"><%=collect_categories_ids(@post_categories)%></div>

													<!--<ul class="movie-subtext">
															<li>PG-13</li>
															<li>2h 32min</li>
															<li>Action, Adventure, Fantasy</li>
															<li>15 December 2017 (USA)</li>
													</ul>-->


													<!--
													<a href="#" class="btn btn-main btn-effect">watch later</a>
													<a href="#" class="btn rate-movie"><i class="far fa-heart"></i></a> -->

													<div class="mt-3">
														<div class="stars">
															<input class="rating-input" type="hidden" value="<%=@post.rating%>" />
															<div class="rating"></div>
											
															<% if @post.rating == -1 %>
																<div class="d-inline-flex">
																	<p class="fas fa-star text-warning mr-2"></p>
																	<p class="text-white">Não há avaliações</p>
																</div>
															<%end%>	
														</div>
													</div>
											</div>

											<div class="clearfix"></div>

									</div>
							</div>
					</div>
			</section>
			<!-- =============== End OF MOVIE DETAIL INTRO 2 =============== -->


			<!-- =============== START OF MOVIE DETAIL MAIN SECTION =============== -->
			<section class="movie-detail-main ptb100">
				<div class="container">
					<div class="row">
						<!-- Start of Movie Main -->
						<div class="col-lg-8 col-sm-12">
							<div class="inner pr50">

								<!-- Storyline -->
								<div class="storyline">
									<h3 class="title">Descrição</h3>

									<p><%= @post.description %></p>
								</div>
							</div>
						</div>

						<div class="col-lg-4 col-sm-12">
							<div class="sidebar shadow">

								<!-- Start of Details Widget -->
								<aside class="widget widget-movie-details">
									<h3 class="title">Detalhes</h3>

									<ul>
										<li style="font-size: 1rem">
											<span class="far fa-calendar-alt text-info mr-2 mb-3"></span>
											<strong>Data de Lançamento: </strong><%=@post.created_at.strftime("%d/%m/%Y")%>
										</li>

										<li style="font-size: 1rem">
											<span class="far fa-calendar-plus text-success mr-2 mb-3"></span>
											<strong>Última Atualização: </strong><%=@post.updated_at.strftime("%d/%m/%Y")%>
										</li>

										<% if @post.owner_id.zero?%>
											<li style="font-size: 1rem">
												<span class="fas fa-user-cog text-f-orange mr-2 mb-3"></span>
												<strong>Criador: </strong>FEJECE
											</li>
										<%else%>
											<li style="font-size: 1rem">
												<span class="fas fa-user-cog text-f-orange mr-2 mb-3"></span>
												<strong>Criador: </strong><%= @ejs.find{|ej| ej.id == @post.owner_id.name} %>
											</li>
										<%end%>

										<% if @post.rating == -1%>
											<li style="font-size: 1rem">
												<span class="fas fa-star mr-2 mb-3 text-warning"></span>
												<strong>Não há avaliações</strong>
											</li>
										<%else%>
											<li style="font-size: 1rem">
												<span class="fas fa-star mr-2 mb-3 text-warning"></span>
												<strong>Avaliação: </strong><%=@post.rating%>
											</li>
										<%end%>

									</ul>
								</aside>
								<!-- End of Details Widget -->

							</div>
                    	</div>
					</div>
				</div>

				<div class="container">
					<form class="evaluation-form">
						<%if @vote.nil?%>
							<h3 class="title">Deixe sua avaliação</h3>
							<input type="hidden" id="value" value="0" />
						<%else%>
							<h3 class="title">Sua avaliação foi:</h3>
							<input type="hidden" id="value" value="<%= @vote.value %>" />
						<%end%>
						
						<div class="make-evaluation mb-5 mt-2">
							<button type="button" class="button-evaluation far fa-star bg-transparent border-0 text-warning" value="2"></button>
							<button type="button" class="button-evaluation far fa-star bg-transparent border-0 text-warning" value="4"></button>
							<button type="button" class="button-evaluation far fa-star bg-transparent border-0 text-warning" value="6"></button>
							<button type="button" class="button-evaluation far fa-star bg-transparent border-0 text-warning" value="8"></button>
							<button type="button" class="button-evaluation far fa-star bg-transparent border-0 text-warning" value="10"></button>
						</div>

						<input type="hidden" id="post_id" value="<%= @post.id %>" />
					</form>
				</div>
			</section>
			<!-- =============== END OF MOVIE DETAIL MAIN SECTION =============== -->



			<!-- =============== START OF RECOMMENDED MOVIES SECTION =============== -->
			<section class="latest-movies bg-light ptb100">
					<div class="container">

							<!-- Start of row -->
							<div class="row">
									<div class="col-md-8 col-sm-12">
											<h2 class="title">Pessoas também gostaram de...</h2>
									</div>
							</div>
							<!-- End of row -->


							<!-- Start of Latest Movies Slider -->
							<div class="row owl-carousel latest-movies-slider mt-20">
								<!-- === Start of Sliding Item 1 === -->

								<%counter = 0%>
								<% vector = [] %>
								<% best_evaluated(vector)%>

								<% vector.each do |post|%>
									<% if post.kind = @post.kind and post != @post%>
										<%if counter < 10 %>
											<div class="item">
												<!-- Start of Movie Box -->
												<div class="movie-box-1">

														<!-- Start of Poster -->
														<div class="poster">
																<%if post.poster_image.attached?%>
																	<%= image_tag post.poster_image.variant(gravity:'Center',resize:"265x395^"  , crop: '265x395+0+0')%>
																<%end%>
														</div>
														<!-- End of Poster -->

														<!-- Start of Buttons -->
														<div class="buttons">
															<% if post.kind == 'video'%>
																<a class="play-video" href="https://www.youtube.com/watch?v=<%= @post.link%>" id="<%= @post.id %>">
																	<i class="fas fa-play"></i>
																</a>
															<% elsif post.kind == 'post'%>
																<a class="open-post" target="_blank" href="https://<%= @post.link%>" id="<%= @post.id %>">
																	<i class="fas fa-link"></i>
																</a>
															<% end %>
														</div>
														<!-- End of Buttons -->

														<!-- Start of Movie Details -->
														<div class="movie-details">
																<h4 class="movie-title">
																	<%= link_to  current_user_post_path(post.id) do%>
																		<%= post.name.length <= 60? post.name : post.name[0..59] + "..."  %>
																	<%end%>
																</h4>
																<span class="released"><%= post.created_at.strftime("%d/%m/%Y") %></span>
														</div>
														<!-- End of Movie Details -->

														<!-- Start of Rating -->
														<div class="stars">
															<input class="rating-input" type="hidden" value="<%=post.rating%>" />
															<div class="rating"></div>
											
															<% if post.rating == -1 %>
																<div class="d-inline-flex">
																	<h6 class="fas fa-star text-warning mr-2 mt-0"></h6>
																	<h6 class="text-white mt-0">Não há avaliações</h6>
																</div>
															<%else%>
																<h6 class="text-white mt-0"><%=post.rating%>/10</h6>
															<%end%>	

														</div>
														<!-- End of Rating -->

												</div>
											</div>

											<%counter += 1%>

										<%end%>		
									<%end%>  
								<%end%>
								<!-- === End of Sliding Item 1 === --> 
							</div>	
							<!-- End of Latest Movies Slider -->

					</div>
			</section>
			<!-- =============== END OF RECOMMENDED MOVIES SECTION =============== -->

			<%= render '/layouts/member_footer' %>

			<!-- =============== JAVASCRIPT FILES =============== -->
			<%# javascript_include_tag 'my_channel' %>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.3/umd/popper.min.js"></script>
			<%= javascript_include_tag 'post' %>
			<%= javascript_include_tag 'pagination_evaluation' %>
			<%= javascript_include_tag 'jquery-3.2.1.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'bootstrap.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'jquery.ajaxchimp', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'jquery.magnific-popup.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'jquery.mmenu', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'jquery.inview.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'jquery.countTo.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'jquery.countdown.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'owl.carousel.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'imagesloaded.pkgd.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'isotope.pkgd.min', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'headroom', 'data-turbolinks-track': 'reload' %>
			<%= javascript_include_tag 'custom', 'data-turbolinks-track': 'reload' %>
			<script> $("#value").val('<%= @vote.value%>'); </script>

		</body>
	</html>    

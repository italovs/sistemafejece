<!DOCTYPE html>
	<html lang="pt-BR">
    <head>
      <title>Minha biblioteca</title>
      <meta charset="UTF-8">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>
      <!-- ===== Mobile viewport optimized ===== -->
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <meta name="viewport" content="width=device-width, initial-scale=1.0,maximum-scale=1.0, user-scalable=no">

      <!-- ===== Meta Tags - Description for Search Engine purposes ===== -->
      <meta name="description" content="Movify - Movies, Series & Cinema HTML Template">
      <meta name="keywords" content="movies, series, online streaming, html template, cinema html template">
      <meta name="author" content="GnoDesign">
      <meta name="turbolinks-visit-control" content="reload">


      <%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
      <%= stylesheet_link_tag 'application', media: 'all' %>

      <!-- ===== Favicon & Different size apple touch icons ===== -->
      <link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon">
      <link rel="apple-touch-icon" sizes="57x57" href="assets/images/apple-touch-icon-iphone.png">
      <link rel="apple-touch-icon" sizes="76x76" href="assets/images/apple-touch-icon-ipad.png">
      <link rel="apple-touch-icon" sizes="120x120" href="assets/images/apple-touch-icon-iphone-retina.png">
      <link rel="apple-touch-icon" sizes="152x152" href="assets/images/apple-touch-icon-ipad-retina.png">
      <link rel="apple-touch-icon" sizes="167x167" href="assets/images/apple-touch-icon-ipad-pro.png">
      <link rel="apple-touch-icon" sizes="180x180" href="assets/images/apple-touch-icon-iphone-6-plus.png">
      <link rel="icon" sizes="192x192" href="assets/images/icon-hd.png">
      <link rel="icon" sizes="128x128" href="assets/images/icon.png">

      <!-- ===== Google Fonts ===== -->
      <link href="https://fonts.googleapis.com/css?family=Quicksand:300,400,500,700" rel="stylesheet">
      <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
      <link href="https://use.fontawesome.com/releases/v5.15.2/css/all.css" rel="stylesheet">
        

      <!-- ===== CSS links ===== -->
      <%= stylesheet_link_tag 'application', media: 'all' %>
      <%= stylesheet_link_tag 'bootstrap.min', media: 'all' %>
      <%= stylesheet_link_tag 'revolution/css/settings', media: 'all' %>
      <%= stylesheet_link_tag 'revolution/css/layers', media: 'all' %>
      <%= stylesheet_link_tag 'revolution/css/navigation', media: 'all' %>
      <%= stylesheet_link_tag 'magnific-popup', media: 'all' %>
      <%= stylesheet_link_tag 'jquery.mmenu', media: 'all' %>
      <%= stylesheet_link_tag 'owl.carousel.min', media: 'all' %>
      <%= stylesheet_link_tag 'style', media: 'all' %>
      <%= stylesheet_link_tag 'responsive', media: 'all' %>
    </head>

    <style>
      .mm-slideout{
        z-index: 9999;
      }

      #main-mobile-nav{
        z-index: 9999;
      }

      .header{
        background: trasnparent !important;
      }

      .overlay-gradient .slotholder:after,
      .overlay-gradient:after {
        opacity:1.0 !important;
      }

      a:visited {
        color: #fff; }

      .overlay-gradient .slotholder:after,
      .overlay-gradient:after,
      .blog-post .blog-thumb a:before,
      ul.blog-posts-widget .blog-content .blog-thumb a:before,
      .celebrity-list-1 .celebrity-image a:before,
      .celebrity-grid-1 .celebrity-image a:before,
      .bloglist-post-holder .bloglist-thumb-link .bloglist-post-thumbnail:after,
      .movie-box-1 .poster:before,
      .movie-detail-intro2 .movie-poster:before {
          background: -webkit-gradient(linear, left top, left bottom, from(#018c77), to(#e27321));
          background: -webkit-linear-gradient(bottom, #e27321 20%, #018c77 100%);
          background: -o-linear-gradient(bottom, #e27321 20%, #018c77 100%);
          background: linear-gradient(to bottom, #018c77 20%, #e27321 100%);
      }
    </style>
    
    <body class="bg-light">
      <%if true == false %>
        <div id="new_post" class="btn btn-primary">Novo Post</div>
        <div id="my_posts" class="btn btn-primary">Meus Posts</div>


        <%# novo post %>
        <%= text_field_tag :post_name, nil, placeholder: "Nome" %>
        <%= text_field_tag :post_description, nil, placeholder: "Descrição" %>
        <%= select_tag :post_category, options_from_collection_for_select(@categories, "id", "name"), {:include_blank => "Selecione"} %>
        <%= text_field_tag :post_link, nil, placeholder: "Link do Arquivo" %>
        <div id="create_new_post" class="btn btn-primary">CRIAR</div>
        <div id="posts_area">
        </div>
        <!--CAMPOS DAS IMAGENS SÓ COLOCAR DENTRO DA NOVA ESTRUTURA LOGO A BAIXO DO NOME DA PUBLICAÇÃO -->

        <div class="form-row video-field">
          <div class="form-group col-md-12">
            <p class="text-muted d-block mb-2">Poster da publicação</p>
            <%= file_field_tag :poster_image, title: "poster da publicação", class: "input_field form-control", id:"poster_image", accept:"image/jpg, image/png, image/jpeg"%>
          </div>  
        </div>

        <div class="form-row video-field">
          <div class="form-group col-md-12">
            <p class="text-muted d-block mb-2">Banner da publicação</p>
            <%= file_field_tag :banner_image, placeholder: "Banner da publicação", class: "input_field form-control", id:"banner_image", accept:"image/jpg, image/png, image/jpeg" %>
          </div>  
        </div>
      <%end%>

      <nav id="main-mobile-nav"></nav>
      <%= render '/layouts/member_navbar' %>
      <%= yield %>


      <div class="m-0">
        <section class="page-header overlay-gradient" style="z-index: 0;">
          <div class="container">
              <div class="inner py-4">
                  <h2 class="title pb-1">Meus Posts</h2>
                  <ol class="breadcrumb">
                      <li><%=link_to "Home", logged_root, class:"text-white" %></li>
                      <li>Meus Posts</li>
                  </ol>
              </div>
          </div>
        </section>

        <br />
        <br />
        <br />
        
        <div class="container p-0">
          <div class="d-flex justify-content-end">
            <div id="new_post" class="btn btn-f-green text-white mx-3">
              Novo Post
            </div>
          </div>

          <main class="ptb50">
            <div class="container">
              <table class="row border-0" id="my_library_posts" data-page-length='3'>
                <thead>
                  <tr>
                    <th class="border-0"></th>
                  </tr>
                </thead>

                <tbody>
                  <!-- Movie List Item -->
                  <% @posts.each do |post| %>
                    <div class="row">
                      <tr class="col-12 col-md-6 col-xl-4 float-left d-flex justify-content-center">
                          <th class="border-0 p-0">
                            <div class="movie-box-3 mb30">
                              <div class="listing-container">

                                <!-- Movie List Image -->
                                <div class="listing-image">
                                  <%if post.poster_image.attached?%>
                                    <%= image_tag post.poster_image.variant(gravity:'Center',resize:"100x150^"  , crop: '100x150+0+0')%>
                                  <%end%>
                                </div>

                                <!-- Movie List Content -->
                                <div class="listing-content border-top">
                                  <div class="inner">

                                    <!-- Play Button -->
                                    <div class="play-btn">
                                      <a class="open-post" target="_blank" href="https://<%= post.link%>" id="<%= post.id %>">
                                        <i class="fas fa-link"></i>
                                      </a>
                                    </div>
                                    

                                    <h2 class="title"><%=post.name.length <= 60? post.name : post.name[0..59] + "..." %></h2>

                                    <!-- Start of Rating -->
                                    <div class="stars">
                                      <input class="rating-input" type="hidden" value="<%=post.rating%>" />
                                      <div class="rating"></div>
                      
                                      <% if post.rating == -1 %>
                                        <div class="d-inline-flex">
                                          <h6 style="font-size:12px;" class="fas fa-star text-warning mr-2"></h6>
                                          <h6 style="font-size:12px;" class="text-dark">Não há avaliações</h6>
                                        </div>
                                      <%else%>
                                        <h6 class="text-white mt-0"><%=post.rating%>/10</h6>
                                      <%end%>	

                                      <!-- End of Rating --> 

                                      <% aux =  @post_categories.where(post_id: post.id)%>
                                      <span class="category text-dark pt-1"><strong><%=collect_categories_ids(aux)%></strong></span>

                                    </div>

                                    <p class="mt-1"><%=post.description.length <= 350? post.description : post.description[0..349] + "..."%></p>

                                    <%= link_to  current_user_post_path(post.id), class: "btn btn-main btn-effect" do%>
                                        Detalhes
                                    <%end%>
                                    <div class="buttons" style="display: inline-flex; margin-left: 8rem;">
                                      <li class="tooltips edit_post mr-3" value="<%=post.id%>" title="Editar" data-placement="bottom" style="list-style:none">
                                        <i class="fas fa-pencil-alt"></i>
                                      </li>

                                      <li href="" class="tooltips delete_post" value="<%=post.id%>" title="Excluir" data-placement="bottom" style="list-style:none">
                                        <i class="fas fa-trash-alt"></i>
                                      </li>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </th>

                      </tr>
                    </div>  
                  <%end%>
                  
                </tbody>  
              </table>
            </div>
          </main>
        </div>      


        <div id="full-content" style="margin: 0 5%;" class="ptb50">
          <div class="row d-flex justify-content-center">
            <div class="col-lg-8">
              <div class="card card-small mb-4">
                <div class="card-header border-bottom bg-f-green">
                  <h6 id="main_title" class="m-0 text-white">Novo Post</h6>
                </div>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item p-3">
                    <div class="row">
                      <div class="col">
                        <form>

                          <div class="form-row">
                            <div class="form-group col-md-12">
                              <%= text_field_tag :post_name, nil, placeholder: "Nome", class: "input_field form-control", id: "post_name"%>
                            </div>  
                          </div>

                          <div class="form-row">
                            <div class="form-group col-md-12">
                              <p class="text-muted d-block mb-2 d-inline-flex">Poster da publicação</p>
                              <small class= "form-text text-muted d-inline-flex" style="font-size: 12px !important">dimensão recomendado 300x444|tamanho máximo 5 mb</small>
                              <%= file_field_tag :poster_image, title: "poster da publicação", class: "input_field form-control", id:"poster_image", accept:"image/jpg, image/png, image/jpeg"%>
                            </div>  
                          </div>

                          <div class="form-row">
                            <div class="form-group col-md-12">
                              <p class="text-muted d-block mb-2 d-inline-flex">Banner da publicação</p>
                              <small class= "form-text text-muted d-inline-flex" style="font-size: 12px !important">dimensão recomendado 1600x803|tamanho máximo 5 mb</small>
                              <%= file_field_tag :banner_image, placeholder: "Banner da publicação", class: "input_field form-control", id:"banner_image", accept:"image/jpg, image/png, image/jpeg" %>
                            </div>  
                          </div>

                          <div class="form-row">
                            <div class="form-group col-md-12">
                              <%= text_field_tag :post_link, nil, placeholder: "Link do Arquivo começando com www", class: "input_field form-control" %>
                            </div>  
                          </div>
                          <div class="form-row">
                            <div class="form-group col-md-12">
                            <p class="text-muted d-block mb-2 d-inline-flex">Categorias</p>
                              <%= select_tag :post_category, options_from_collection_for_select(Category.all,'id','name'),{class: 'select_field custom-select form-control selectize mb-3', style: "height:100%;",multiple: true}%>
                            </div> 
                          </div>
                          

                          <div class="form-row">
                            <div class="form-group col-md-12">
                              <%= text_area_tag :post_description, nil, placeholder: "Descrição", class: "input_field form-control", rows:"5" %>
                            </div>  
                          </div>

                          <div id="create_new_post" class="btn btn-f-green text-white">
                            Criar
                          </div>
                          <input id="update_input" type="hidden" value="" />

											    <div id="update_post" class="btn btn-f-green text-white">
												    Atualizar
											    </div>

                        </form>
                      </div>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

       

      <br/><br/>

      <%= render '/layouts/member_footer' %>


      <script src="<%= javascript_path "essencials" %>"></script>
      <%= javascript_include_tag 'assets/datatables.min.js', 'data-turbolinks-track': 'reload', :defer=>"defer" %>
      <%= javascript_include_tag 'pagination_evaluation', 'data-turbolinks-track': 'reload'%>
      <%= javascript_include_tag 'my_library.js', 'data-turbolinks-track': 'reload' %>
      <!-- ===== All Javascript at the bottom of the page for faster page loading ===== -->
      <%= javascript_include_tag 'jquery-3.2.1.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'bootstrap.min', 'data-turbolinks-track': 'load' %>
      <%= javascript_include_tag 'jquery.ajaxchimp', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'jquery.magnific-popup.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'jquery.mmenu', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'jquery.inview.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'jquery.countTo.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'jquery.countdown.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'owl.carousel.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'imagesloaded.pkgd.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'isotope.pkgd.min', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'headroom', 'data-turbolinks-track': 'reload' %>
      <%= javascript_include_tag 'custom', 'data-turbolinks-track': 'reload' %>
    
    </body>
  </html>  
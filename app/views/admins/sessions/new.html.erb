<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <%# TODO: colocar um título %>
    <title>Farol - Admin</title>
    <%# TODO: mudar com descrição do sistema %>
    <meta name="description" content="Mudar com a descrição do sistema.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
</head>


<body>

  <style>
    body{
      background: rgb(216,117,46);
      background: linear-gradient(145deg, rgba(216,117,46,1) 40%, rgba(1,140,119,1) 60%);
      height: 100%;
    }
  </style>

  <div class="col-lg-4 col-md-4 auth-form mx-auto mt-3">
    <div class="card">
      <div class="card-body">
        <img class="auth-form__logo d-table mx-auto " src="/images/fejece_logo_fundo_branco.jpg" alt="Logo FEJECE">
        <h5 class="auth-form__title text-center">Acesse sua Conta</h5>
        

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= notice || alert %>
          <div class="form-group">
            <label for="exampleInputEmail1">Email</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Email" %>
          </div>
          <div class="form-group">
            <label for="exampleInputPassword1">Senha</label>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Senha" %>
          </div>
          <div class="form-group d-table mx-0 pt-3">
            <div class="custom-control custom-checkbox p-0">
              <% if devise_mapping.rememberable? %>
                <div class="field">
                  <input type="checkbox" class="custom-control-input d-inline" id="customCheck2" name="admin[remember_me]">
                  <label class="custom-control-label d-inline" for="customCheck2">Lembre de mim</label>
                </div>
              <% end %>
            </div>
          </div>
          <%= f.submit "Entrar", class: "btn btn-pill btn-f-orange text-white d-table mx-auto" %>
        <% end %>
      </div>
      <div class="card-footer border-top">
          <div class="row">
            <div class="col-6 d-flex ">
              <%= link_to "Logar como membro", new_member_session_path%>
            </div>
          </div>  
        </div>
    </div>
  </div>
</body>
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" 
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">

<div class="container" style="padding: 0% 20%;">

    <div class="p-0" style="background: #018C77;">
        <div class="row display-flex justify-content-center mx-1" style="border-bottom: 1px solid #fff;">
            <img id="main-logo" class="d-inline-block text-dark align-top mr-1" style="max-width: 240px;" 
                                src="https://storage.googleapis.com/farol-fejece/Logotipo%20Plataforma%20Farol/SVG/farol_Logo%20branca%20sem%20palavra%20embaixo.svg" 
                                alt="Farol">
        </div>

        <div class="divider"></div>

        <div class="row mx-4 py-3" style="border-bottom: 1px solid #fff;">
            <h6 class="text-white col-12"><strong>Nome:</strong></h6>

            <h6 class="text-white col-12"><%= @current_user.name %></h6>
        </div>

        <div class="row mx-4 py-3" style="border-bottom: 1px solid #fff;">
            <h6 class="text-white col-12"><strong>E-mail:</strong></h6>

            <h6 class="text-white col-12"><%= @current_user.email %></h6>
        </div>

        <% if @phone != "" %>
            <div class="row mx-4 py-3" style="border-bottom: 1px solid #fff;">
            <h6 class="text-white col-12"><strong>Telefone:</strong></h6>

            <h6 class="text-white col-12"><%= @phone %></h6>
        </div>
        <% end %>   

        <div class="row mx-4 py-3">
            <h6 class="text-white col-12"><strong>Mensagem:</strong></h6>

            <h6 class="text-white col-12"><%= @message %></h6>
        </div>

        <div class="row d-flex justify-content-center mx-1 py-4" style="border-top: 1px solid #fff;">
            <div class="text-white">
                Desenvolvido com <span style="color: red;">❤</span> por <a href="https://gtijr.com/" style="color: #02e1f5;">GTi Engenharia Jr</a>
            </div>
        </div>
    </div>    

</div>


<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>

Verificar diretoria de EJ
<table id="membros">
	<thead>
		<tr>
			<th>Nome</th>
			<th>EJ</th>
			<th colspan="2"></th>
		</tr>
	</thead>

	<tbody id="membros_t">
		<% @not_yet_directors.each do |member| %>
			<tr>
				<td><%= member.name %></td>
				<td><%= member.junior_enterprise.name %></td>
				<td><div class="btn btn-primary" id="director_<%= "#{member.id}" %>">Tornar Diretor</div></td>
				<td><div class="btn btn-primary" id="member_<%= "#{member.id}" %>">Tornar Membro</div></td>
			</tr>
		<% end %>
	</tbody>
</table>



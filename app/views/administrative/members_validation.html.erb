
Verificar diretoria de EJ
<table id="membros">
	<thead>
		<tr>
			<th>Nome</th>
			<th>EJ</th>
			<th colspan="2"></th>
		</tr>
	</thead>

	<tbody id="membros_t">
		<% @not_yet_directors.each do |member| %>
			<tr>
				<td><%= member.name %></td>
				<td><%= member.junior_enterprise.name %></td>
				<td><div class="btn btn-primary" id="director_<%= "#{member.id}" %>">Tornar Diretor</div></td>
				<td><div class="btn btn-primary" id="member_<%= "#{member.id}" %>">Tornar Membro</div></td>
			</tr>
		<% end %>
	</tbody>
</table>


Diretores cadastrados
<table id="diretores">
	<thead>
		<tr>
			<th>Nome</th>
			<th>EJ</th>
			<th colspan="2"></th>
		</tr>
	</thead>

	<tbody id="diretores_t">
		<% @directors.each do |member| %>
			<tr>
				<td><%= member.name %></td>
				<td><%= member.junior_enterprise.name %></td>
				<td><div class="btn btn-primary" id="member_<%= "#{member.id}" %>">Tornar Membro</div></td>
			</tr>
		<% end %>
	</tbody>
</table>


<script>

$(function(){
	$("div.btn.btn-primary").on("click", function(){
		id = $(this).attr("id");
		if( id.substring( 0, id.indexOf("_")) == "director" ){
			director = true;
		} else if( id.substring( 0, id.indexOf("_")) == "member" ){
			director = false;
		}
		member_id = id.substring( id.indexOf("_") + 1, id.length)
		$.post("/pirates/director/change_validation",
		{
			id: member_id,
			status: director
		},
		function(data, status){
			if(status == "success"){
				refill_table("#membros", data[0]["members"], "member")
				refill_table("#diretores", data[0]["directors"], "directors")
			}
		});
	})
})

function refill_table( table_id, dados, kind ){
	$( table_id ).empty()
	if ($(table_id+" tbody").length == 0) {
    $(table_id).append("<tbody></tbody>");
	}
	for(i = 0; i < dados.length; i++){
		line = create_line(dados[i], kind)
		$( 'tbody', table_id).append(line)
	}

}

function create_line(dados, kind){
	line = "<tr><td>"+dados[1]+"</td><td>"+dados[2]+"</td><td><div "
	if(kind == "member"){
		line += 'id="director_'+dados[0]+'" class="btn btn-primary">Tornar Diretor' 
		line += '</div></td><td><div id="member_'+dados[0]+'" class="btn btn-primary">Tornar Membro';
	} else {
		line += 'id="member_'+dados[0]+'" class="btn btn-primary">Tornar Membro';
	}
	line += "</div></td></tr>"
	return line
}



</script>
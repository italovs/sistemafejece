<div class="row">
<div class="col">
  <div class="card card-small mb-4">
	<div class="card-header border-bottom bg-info">
	  <h6 class="m-0 text-white">Verificar diretoria de EJ</h6>
	</div>
	<div class="card-body p-0 pb-3 text-center">
	  <table class="table mb-0" id="membros">
		<thead class="bg-light">
		  <tr>
			<th scope="col" class="border-0">#</th>
			<th scope="col" class="border-0">Nome</th>
			<th scope="col" class="border-0">EJ</th>
			<th scope="col" class="border-0">Ações</th>
		  </tr>
		</thead>
		<tbody id="membros_t">
			<% cont = 1 %>
			<% @not_yet_directors.each do |member| %>
				<tr>
					<td><%= cont %></td>
					<td><%= member.name %></td>
					<td><%= member.junior_enterprise.name %></td>
					<td>
						<i class="btn btn-success material-icons" title="Tornar diretor" id="director_<%= "#{member.id}" %>">check</i>
						<i class="btn btn-danger material-icons" title="Tornar membro" id="member_<%= "#{member.id}" %>">close</i>
					</td>
					<% cont = cont + 1%>
				</tr>
			<% end %>
		</tbody>
	  </table>
	</div>
  </div>
</div>
</div>


<div class="field" id="profile_info">
	<strong>
		Nome: 
	</strong>
	<span id="name"><%= @profile.name.nil? ? "Não informado" : @profile.name %></span>
</div>
<div class="field">
	<strong>
		E-mail: 
	</strong>
	<span id="email"><%= @profile.email %></span>
</div>
<div class="field">
	<strong>
		Sobre: 
	</strong>
	<span id="about"><%= @profile.about.nil? ? "Não informado" : @profile.about %></span>
</div>

<br>
<br>



		<div style="margin: 0 5%;">
			<div class="row">
              <div class="col-lg-4">
                <div class="card card-small mb-4 pt-3">
                  <div class="card-header border-bottom text-center bg-white">
                    <div class="mb-3 mx-auto">
                       <%if current_logged_user.profile_picture.attached?%>
									        <%= image_tag current_logged_user.profile_picture.variant(resize_to_limit:[150,150]), :class=>"rounded-circle"%>
								       <%else%>
									        <%= image_tag TEMPLATE_IMAGE_FOR_PROFILE,:size=>"150x150", :class =>"rounded-circle"%>
								       <%end%>
                    </div>
                    <h4 class="mb-0"><%=logged_name%></h4>
                  </div>
                  <ul class="list-group list-group-flush">
                    <li class="list-group-item p-4">
                      <strong class="text-muted d-block mb-2">Sobre</strong>
                      <span><%= @profile.about.nil? ? "Não informado" : @profile.about %></span>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="col-lg-8">
                <div class="card card-small mb-4">
                  <div class="card-header border-bottom bg-info">
                    <h6 class="m-0 text-white">Detalhes do Perfil</h6>
                  </div>
                  <ul class="list-group list-group-flush">
                    <li class="list-group-item p-3">
                      <div class="row">
                        <div class="col">
                          <form>
                            <div class="form-row">
                              <div class="form-group col-md">
                                <label for="feFirstName">Nome</label>
                                <input type="text" class="form-control" id="name" placeholder="Name" value="<%= @profile.name.nil? ? "Não informado" : @profile.name %>">
                              </div>
                              <div class="form-group col-md">
                                <label for="feEmailAddress">E-mail</label>
                                <input type="email" class="form-control" id="email" placeholder="E-mail" value="<%= @profile.email %>">
                              </div>
                            </div>
                            <div class="form-row">
                              <div class="form-group col-md-12">
                                <label for="feAbout">Sobre</label>
                                <textarea class="form-control" name="about" rows="5"><%= @profile.about.nil? ? "Não informado" : @profile.about %></textarea>
                              </div>
                            </div>
                            <button type="submit" class="btn btn-accent">Atualizar Informações</button>
                          </form>
                        </div>
                      </div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
		</div>	


<div class="field profile_data">
	<%= text_field_tag :name_field, nil, placeholder: "Nome", class: "input_field", value: @profile.try(:name) %>
</div>

<div class="field profile_data">
	<%= text_area_tag :about_field, nil, placeholder: "Descrição", class: "input_field", value: @profile.try(:description) %>
</div>

<div class="field profile_data email">
	<%= text_field_tag :new_email, nil, placeholder: "Novo Email", class: "input_field"%>
</div>

<div class="field profile_data email">
	<%= text_field_tag :repeat_email, nil, placeholder: "Repetir Email", class: "input_field"  %>
</div>

<div class="field password">
	<%= password_field_tag :old_password, nil, placeholder: "Senha Atual", class: "input_field" %>
</div>

<div class="field password">
	<%= password_field_tag :new_password, nil, placeholder: "Nova Senha", class: "input_field" %>
</div>

<div class="field password">
	<%= password_field_tag :confirmation_password, nil, placeholder: "Repetir Nova Senha", class: "input_field" %>
</div>

<div id="change_information" class="btn btn-primary">
	ATUALIZAR INFORMAÇÕES
</div>

<div id="change_mail" class="btn btn-primary">
	Mudar E-mail
</div>

<div id="change_password" class="btn btn-primary">
	Nova Senha
</div>


<script src="<%= javascript_path "essencials" %>"></script>
<script src="<%= javascript_path "profile" %>"></script>
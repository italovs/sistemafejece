<!doctype html>
<html class="no-js h-100" lang="pt-BR">
  <head>
    <%= csrf_meta_tag %>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <%# TODO: colocar um título %>
    <title>App Exemplo</title>
    <%# TODO: mudar com descrição do sistema %>
    <meta name="description" content="Mudar com a descrição do sistema.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%#= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <%= csrf_meta_tags %>
    
  </head>
  <body class="h-100">
    <div class="container-fluid">
      <div class="row">
        <%= render partial: 'layouts/administrative/sidebar' %>
        <main class="main-content col-lg-10 col-md-9 col-sm-12 p-0 offset-lg-2 offset-md-3">
          <div class="main-navbar sticky-top bg-white">
            <%= render partial: 'layouts/administrative/navbar' %>
          </div>
          <div class="main-content-container container-fluid px-4">
            <%= yield %>
          </div>
          <%= render partial: 'layouts/administrative/footer' %>
        </main>
      </div>
    </div>
    <script src="https://unpkg.com/shards-ui@latest/dist/js/shards.min.js"></script>
    <%= javascript_include_tag 'application.js' %>
  </body>
</html>

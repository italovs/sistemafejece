<!DOCTYPE html>

<html lang="pt-BR">

<head>
	<meta charset="UTF-8">
	<%= csrf_meta_tags %>
	<!-- ===== Mobile viewport optimized ===== -->
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0,maximum-scale=1.0, user-scalable=no">

	<!-- ===== Meta Tags - Description for Search Engine purposes ===== -->
	<meta name="description" content="Movify - Movies, Series & Cinema HTML Template">
	<meta name="keywords" content="movies, series, online streaming, html template, cinema html template">
	<meta name="author" content="GnoDesign">
	<meta name="turbolinks-visit-control" content="reload">
    <%= render 'application/favicon' %>
	<!-- ===== Website Title ===== -->
	<title>Farol</title>

	<%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
  	<%= stylesheet_link_tag 'application', media: 'all' %>

	<!-- ===== Favicon & Different size apple touch icons ===== -->
	<link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon">
	<link rel="apple-touch-icon" sizes="57x57" href="assets/images/apple-touch-icon-iphone.png">
	<link rel="apple-touch-icon" sizes="76x76" href="assets/images/apple-touch-icon-ipad.png">
	<link rel="apple-touch-icon" sizes="120x120" href="assets/images/apple-touch-icon-iphone-retina.png">
	<link rel="apple-touch-icon" sizes="152x152" href="assets/images/apple-touch-icon-ipad-retina.png">
	<link rel="apple-touch-icon" sizes="167x167" href="assets/images/apple-touch-icon-ipad-pro.png">
	<link rel="apple-touch-icon" sizes="180x180" href="assets/images/apple-touch-icon-iphone-6-plus.png">
	<link rel="icon" sizes="192x192" href="assets/images/icon-hd.png">
	<link rel="icon" sizes="128x128" href="assets/images/icon.png">

	<!-- ===== Google Fonts ===== -->
	<link href="https://fonts.googleapis.com/css?family=Quicksand:300,400,500,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://use.fontawesome.com/releases/v5.15.2/css/all.css" rel="stylesheet">
    

	<!-- ===== CSS links ===== -->
	<%= stylesheet_link_tag 'application', media: 'all' %>
	<%= stylesheet_link_tag 'bootstrap.min', media: 'all' %>
	<%= stylesheet_link_tag 'revolution/css/settings', media: 'all' %>
	<%= stylesheet_link_tag 'revolution/css/layers', media: 'all' %>
	<%= stylesheet_link_tag 'revolution/css/navigation', media: 'all' %>
	<%= stylesheet_link_tag 'magnific-popup', media: 'all' %>
	<%= stylesheet_link_tag 'jquery.mmenu', media: 'all' %>
	<%= stylesheet_link_tag 'owl.carousel.min', media: 'all' %>
    <!--<%= stylesheet_link_tag 'colors', media: 'all' %>
    <%= stylesheet_link_tag 'simple-line-icons', media: 'all' %>
    <%= stylesheet_link_tag 'themify-icons.css', media: 'all' %>-->
	<%= stylesheet_link_tag 'style', media: 'all' %>
	<%= stylesheet_link_tag 'responsive', media: 'all' %>
	<!--
	<link rel="stylesheet" type="text/css" href="assets/revolution/css/settings.css">
	<link rel="stylesheet" type="text/css" href="assets/revolution/css/layers.css">
	<link rel="stylesheet" type="text/css" href="assets/revolution/css/navigation.css">
	<link rel="stylesheet" type="text/css" href="assets/css/magnific-popup.css">
	<link rel="stylesheet" type="text/css" href="assets/css/jquery.mmenu.css">
	<link rel="stylesheet" type="text/css" href="assets/css/owl.carousel.min.css">

	<link rel="stylesheet" type="text/css" href="assets/css/style.css">
	<link rel="stylesheet" type="text/css" href="assets/css/responsive.css">
	-->

	<!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
	<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
	<!--[if lt IE 9]>
	<script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
	<script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
<![endif]-->
</head>

<body>

    <style>

        a:visited {
            color: #fff; }

    </style>

    <!-- =============== START OF PRELOADER =============== -->
    <div class="loading">
        <div class="loading-inner">
            <div class="loading-effect">
                <div class="object">
                    <i class="fas fa-spinner" style="animation: fa-spin 2s infinite linear; margin-top:24.5%; margin-left:24.5%; color: white; font-size:2em;"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- =============== END OF PRELOADER =============== -->



    <!-- =============== START OF RESPONSIVE - MAIN NAV =============== -->
    <nav id="main-mobile-nav"></nav>
    <!-- =============== END OF RESPONSIVE - MAIN NAV =============== -->



    <!-- =============== START OF WRAPPER =============== -->
    <div class="wrapper">


        <!-- =============== START OF HEADER NAVIGATION =============== -->
        <!-- Insert the class "sticky" in the header if you want a sticky header -->
        <%= render '/layouts/member_navbar' %>
        <!-- =============== END OF HEADER NAVIGATION =============== -->

        <%= yield%>


        <!-- =============== START OF SLIDER REVOLUTION SECTION =============== -->
        <section id="slider" class="full-slider">
            <div class="rev-slider-wrapper fullscreen-container overlay-gradient">
                <div id="fullscreen-slider" class="rev_slider fullscreenbanner" style="display:none" data-version="5.4.1">
                    <ul>

                        <!-- ===== SLIDE NR. 1 ===== -->
                        <li data-transition="fade">
                            <!-- MAIN IMAGE -->
                            <img src="assets/images/slider/slider1.jpg"
                                 alt="Image"
                                 title="slider-bg"
                                 data-bgposition="center center"
                                 data-bgfit="cover"
                                 data-bgrepeat="no-repeat"
                                 data-bgparallax="10"
                                 class="rev-slidebg"
                                 data-no-retina="">
                            <!-- LAYER NR. 1 -->
                            <div class="tp-caption tp-resizeme"
                                 data-x="center"
                                 data-hoffset=""
                                 data-y="middle"
                                 data-voffset="['-30','-30','-30','-30']"
                                 data-responsive_offset="on"
                                 data-fontsize="['60','50','40','30']"
                                 data-lineheight="['60','50','40','30']"
                                 data-whitespace="nowrap"
                                 data-frames='[{"delay":1000,"speed":2000,"frame":"0","from":"y:[100%];z:0;rX:0deg;rY:0;rZ:0;sX:1;sY:1;skX:0;skY:0;opacity:0;","mask":"x:0px;y:[100%];s:inherit;e:inherit;","to":"o:1;","ease":"Power2.easeInOut"},{"delay":"wait","speed":500,"frame":"999","to":"auto:auto;","ease":"Power3.easeInOut"}]'
                                 style="z-index: 5; color: #fff; font-weight: 900;">BEM VINDO AO FAROL
                            </div>
                        </li>

                        <!-- ===== SLIDE NR. 2 ===== -->
                        <li data-transition="fade"
                            data-slotamount="7"
                            data-easein="default"
                            data-easeout="default"
                            data-masterspeed="2000">
                            <!-- MAIN IMAGE -->
                            <img src="assets/images/slider/slider2.jpg"
                                 alt="Image"
                                 title="slider-bg"
                                 data-bgposition="center top"
                                 data-bgfit="cover"
                                 data-bgrepeat="no-repeat"
                                 data-bgparallax="10"
                                 class="rev-slidebg"
                                 data-no-retina="">
                            <!-- LAYER NR. 1 -->
                            <div class="tp-caption tp-resizeme"
                                 data-x="center"
                                 data-hoffset=""
                                 data-y="middle"
                                 data-voffset="['-30','-30','-30','-30']"
                                 data-responsive_offset="on"
                                 data-fontsize="['60','50','40','30']"
                                 data-lineheight="['60','50','40','30']"
                                 data-whitespace="nowrap"
                                 data-frames='[{"delay":1000,"speed":2000,"frame":"0","from":"y:[100%];z:0;rX:0deg;rY:0;rZ:0;sX:1;sY:1;skX:0;skY:0;opacity:0;","mask":"x:0px;y:[100%];s:inherit;e:inherit;","to":"o:1;","ease":"Power2.easeInOut"},{"delay":"wait","speed":500,"frame":"999","to":"auto:auto;","ease":"Power3.easeInOut"}]'
                                 style="z-index: 5; color: #fff; font-weight: 900;">BEM VINDO AO FAROL
                            </div>
                        </li>

                        <!-- ===== SLIDE NR. 3 ===== -->
                        <li data-transition="fade"
                            data-slotamount="7"
                            data-easein="default"
                            data-easeout="default"
                            data-masterspeed="2000">
                            <!-- MAIN IMAGE -->
                            <img src="assets/images/slider/slider3.jpg"
                                 alt="Image"
                                 data-bgposition="center top"
                                 data-bgfit="cover"
                                 data-bgrepeat="no-repeat"
                                 data-bgparallax="3"
                                 class="rev-slidebg"
                                 data-no-retina>
                            <!-- LAYER NR. 1 -->
                            <div class="tp-caption tp-resizeme"
                                 data-x="center"
                                 data-hoffset=""
                                 data-y="middle"
                                 data-voffset="['-30','-30','-30','-30']"
                                 data-responsive_offset="on"
                                 data-fontsize="['60','50','40','30']"
                                 data-lineheight="['60','50','40','30']"
                                 data-whitespace="nowrap"
                                 data-frames='[{"delay":1000,"speed":2000,"frame":"0","from":"y:[100%];z:0;rX:0deg;rY:0;rZ:0;sX:1;sY:1;skX:0;skY:0;opacity:0;","mask":"x:0px;y:[100%];s:inherit;e:inherit;","to":"o:1;","ease":"Power2.easeInOut"},{"delay":"wait","speed":500,"frame":"999","to":"auto:auto;","ease":"Power3.easeInOut"}]'
                                 style="z-index: 5; color: #fff; font-weight: 900;">BEM VINDO AO FAROL
                            </div>
                        </li>

                    </ul>
                </div>
            </div>
            <!-- ===== END OF REV SLIDER WRAPPER ===== -->


            <!-- ===== START OF SEARCH FORM WRAPPER ===== -->
            <div class="search-form-wrapper search-form-rev">
                <div class="container">

                    <!-- ===== START OF SEARCH FORM ===== -->
                    <form id="search-form-1">
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-sm-10 col-12">
                                <div class="form-group">
                                    <input name="search-keyword" type="text" id="search-keyword" value="" class="form-control" placeholder="Enter Movies or Series Title">
                                    <%= link_to  member_search_for_post_path do%>
                                        <button type="submit" class="btn btn-main btn-effect"><i class="fas fa-search text-white"></i></button>
                                    <%end%>    
                                </div>
                            </div>
                        </div>
                    </form>
                    <!-- ===== END OF SEARCH FORM ===== -->

                </div>
            </div>
            <!-- ===== END OF SEARCH FORM WRAPPER ===== -->
        </section>
        <!-- =============== START OF SLIDER REVOLUTION SECTION =============== -->


        <!-- =============== START OF LATEST MOVIES SECTION =============== -->
        <section class="latest-movies ptb100">
            <div class="container">

                <!-- Start of row -->
                <div class="row">
                    <div class="col-md-8">
                        <h2 class="title">Mais Vistos</h2>
                    </div>


                    <div class="col-md-4 align-self-center text-right">
                        <a href="#" class="btn btn-icon btn-main btn-effect">
                            Ver Tudo
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    </div>
                </div>
                <!-- End of row -->


                <!-- Start of Latest Movies Slider -->
                <div class="row owl-carousel latest-movies-slider mt-20">

                    <!-- === Start of Sliding Item 1 === -->
                        <% @posts_and_videos.each do |post|%>    
                            <div class="item">
                                <!-- Start of Movie Box -->
                                <div class="movie-box-1">

                                    <!-- Start of Poster -->
                                    <div class="poster">
                                        <%if post.poster_image.attached?%>
                                            <%= image_tag post.poster_image.variant(gravity:'Center',resize:"265x395^"  , crop: '265x395+0+0')%>
                                        <%end%>
                                    </div>
                                    <!-- End of Poster -->

                                    <!-- Start of Buttons -->
                                    <div class="buttons">
                                        <% if post.kind == 'video'%>
                                            <a class="play-video" href="https://www.youtube.com/watch?v=<%= post.link%>">
                                                <i class="fas fa-play"></i>
                                            </a>
                                        <% elsif post.kind == 'post'%>
                                            <a class="play-video" href="<%= post.link%>">
                                                <i class="fas fa-link"></i>
                                            </a>
                                        <% end %>
                                    </div>
                                    <!-- End of Buttons -->

                                    <!-- Start of Movie Details -->
                                    <div class="movie-details">
                                        <h4 class="movie-title">
                                            <%= link_to current_user_post_path(post.id) do%>
                                                <%= post.name %>
                                            <%end%>    
                                        </h4>
                                        <span class="released"><%= post.created_at.strftime("%d/%m/%Y") %></span>
                                    </div>
                                    <!-- End of Movie Details -->

                                    <!-- Start of Rating -->
                                    <div class="stars">
                                        <input class="rating-input" type="hidden" value="<%=post.rating%>" />
                                        <div class="rating"></div>

                                        <%if post.rating.class == String%>
                                            <div class="d-inline-flex">
                                                <h6 class="fas fa-star text-warning mr-2"></h6>
                                                <h6 class="text-white"><%=post.rating%></h6>
                                            </div>  
                                        <%else%>
                                            <h6 class="text-white"><%=post.rating%>/10</h6>
                                        <%end%>    
                                    </div>
                                    <!-- End of Rating -->

                                </div>
                                <!-- End of Movie Box -->
                            </div>
                        <%end%>
                    <!-- === End of Sliding Item 1 === -->    

                </div>
                <!-- End of Latest Movies Slider -->


            </div>
        </section>
        <!-- =============== END OF LATEST MOVIES SECTION =============== -->

        <!-- =============== START OF HOW IT WORKS SECTION =============== -->
        <section class="how-it-works2 ptb100">
            <div class="container">

                <!-- Start of row -->
                <div class="row justify-content-center">
                    <div class="col-md-7 text-center">
                        <h2 class="title mb-5">Como o Farol Funciona</h2>
                        <h6 class="subtitle"></h6>
                    </div>
                </div>
                <!-- End of row -->

                <!-- Start of row -->
                <div class="row icons-container">
                    <!-- Stage -->
                    <div class="col-md-4 col-sm-12">
                        <div class="icon-box with-line">
                            <i class="fab fa-youtube" style="color:#ff0000;"></i>
                            <h3>Vídeos</h3>
                            <p>São conteúdos selecionados e escritos pela FEJECE, produzindo capacitações para ajudar a solucionar as dores dos empresários juniores!</p>
                        </div>
                    </div>

                    <!-- Stage -->
                    <div class="col-md-4 col-sm-12">
                        <div class="icon-box with-line">
                            <i class="fas fa-layer-group text-success"></i>
                            <h3>Trilhas</h3>
                            <p>São blocos de conteúdo complementares, compilados para uma capacitação mais profunda, feita da FEJECE para você!</p>
                        </div>
                    </div>

                    <!-- Stage -->
                    <div class="col-md-4 col-sm-12">
                        <div class="icon-box">
                            <i class="fas fa-file-alt text-primary"></i>
                            <h3>Materiais complementares</h3>
                            <p>São ferramentas que te ajudam a aplicar o que você aprendeu nas capacitações!
                            </p>
                        </div>
                    </div>
                </div>
                <!-- End of row -->

            </div>
        </section>
        <!-- =============== END OF HOW IT WORKS SECTION =============== -->

        <!-- =============== START OF TOP RATED MOVIES SECTION =============== -->
        <section class="top-movies ptb100">
            <div class="container">

                <!-- Start of row -->
                <div class="row">
                    <div class="col-md-8">
                        <h2 class="title">Trilhas de Conteúdo</h2>
                    </div>


                    <div class="col-md-4 align-self-center text-right">
                        <a href="#" class="btn btn-icon btn-main btn-effect">
                            Ver Tudo
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    </div>
                </div>
                <!-- End of row -->


                <!-- Start of Movie List -->
                <div class="row mt20">
                    <%cont = 0%>
                    <!-- Movie List Item -->
                    <% @videos.each do |post| %>
                        <%cont += 1%>
                      <div class="col-md-12 col-sm-12 var-item">
                        <div class="movie-list-1 mb30">
                            <div class="listing-container">

                                <!-- Movie List Image -->
                                <div class="listing-image">
                                  <%if post.poster_image.attached?%>
                                    <%= image_tag post.poster_image.variant(gravity:'Center',resize:"530x300^"  , crop: '530x300+0+0')%>
                                  <%end%>

                                    <!-- Play Button -->
                                    <div class="play-btn">
                                        <a href="https://www.youtube.com/watch?v=<%= post.link %>" class="play-video">
                                            <i class="fas fa-play"></i>
                                        </a>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="buttons">
                                        <a href="#" data-original-title="Rate" data-toggle="tooltip" data-placement="bottom">
                                            <i class="fas fa-heart"></i>
                                        </a>

                                        <a href="#" data-original-title="Share" data-toggle="tooltip" data-placement="bottom">
                                            <i class="fas fa-share-alt"></i>
                                        </a>
                                    </div>

                                    <!-- Rating -->
                                    <div class="stars">
                                        <input class="rating-input" type="hidden" value="<%=post.rating%>" />
                                        <div class="rating"></div>

                                        <%if post.rating.class == String%>
                                            <div class="d-inline-flex">
                                                <h6 class="fas fa-star text-warning mr-2"></h6>
                                                <h6 class="text-white"><%=post.rating%></h6>
                                            </div>  
                                        <%end%>
                                    </div>

                                    <!-- Image -->
                                    <img src="" alt="">
                                </div>

                                <!-- Movie List Content -->
                                <div class="listing-content">
                                    <div class="inner">
                                        <h2 class="title"><%= post.name %></h2>

                                        <p><%=post.description%></p>

                                        <%= link_to  admin_post_path(post.id), class: "btn btn-main btn-effect" do%>
                                            Detlhes
                                        <%end%>
                                        
                                    </div>
                                </div>

                            </div>
                        </div>
                      </div>
                    <%end%>
            </div>

            <div class="paginate-container videos-row">
                <nav>
                <ul class="paginate d-flex justify-content-center">
                    <% i = 1 %>
                    <% while (i <= (cont.to_f/2).ceil) %>
                    <button id="paginate-item" class="paginate-item page-link d-inline" value="<%= i%>"><%=i%></button>
                    <%i += 1%>
                    <%end%>
                </ul>
                </nav>
            </div>
    
        </section>
        <!-- =============== END OF TOP RATED MOVIES SECTION =============== -->


        <!-- =============== START OF UPCOMING MOVIES SECTION =============== -->
        <section class="upcoming-movies parallax ptb100" data-background="https://storage.googleapis.com/farol-fejece-test/fotos%20pro%20farol/lighthouse-2372461_1920.jpg" 
                data-color="#018c77" data-color-opacity="0.6" >
          <div class="m-0 w-100">

            <!-- Start of row -->
            <div class="row justify-content-center">
                <div class="col-md-6 text-center">
                    <h2 class="title text-white">Conheça a Farol</h2>
                </div>

               
                
            </div>
            <!-- End of row -->



            <!-- Start of row -->
            <div class="row mt50 mx-5">

              <!-- === Start of Upcoming Featured Movies & TV Shows === -->
              <div class="col-md-7">
                <!-- Start of Upcoming Featured Item -->
                <div class="movie-box-1 upcoming-featured-item">

                  <!-- Start of Poster -->
                  <div class="poster">
                    <img src="https://storage.googleapis.com/farol-fejece-test/fotos%20pro%20farol/people-4050698_1920.jpg" alt="">
                  </div>
                  <!-- End of Poster -->

                  <!-- Start of Buttons -->
                  <div class="buttons">
                    <a href="https://www.youtube.com/watch?v=Q0CbN8sfihY" class="play-video">
                      <i class="fas fa-play"></i>
                    </a>
                  </div>
                  <!-- End of Buttons -->

                  <!-- Start of Movie Details -->
                  <div class="movie-details">
                    <h4 class="movie-title">
                      <a href="movie-detail.html">Tomb Raider</a>
                    </h4>
                    <span class="released">Release Date: 15 Mar 2018</span>
                  </div>
                  <!-- End of Movie Details -->
                </div>
                <!-- End of Upcoming Featured Item -->
              </div>

              <div class="col-md-5 col-sm-12">
                <div class="features-wrapper mx-3">
                  <h3 class="title text-white">O que é a plataforma ?</h3>
                  <p class="text-light">A Farol é a Plataforma de Educação Empreendedora da FEJECE, um projeto desenvolvido pela federação para capacitar e desenvolver os empresários e empresárias juniores da Rede Cearense, formando líderes que sabem fazer, querem fazer e fazem. 
                  </p>
                  <a class="btn btn-f-green btn-effect text-white" href="#">Veja Mais</a>
                </div>
              </div>  
            </div>
          </div>
        </section>
        <!-- =============== END OF UPCOMING MOVIES SECTION =============== -->


        <!-- =============== START OF BLOG SECTION =============== -->
        <section class="latest-posts ptb100 bg-light">
            <div class="container">

              <!-- Start of row -->
              <div class="row justify-content-center">
                  <div class="col-md-7 text-center">
                      <h2 class="title">Latest News</h2>
                      <h6 class="subtitle">Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy consectetuer adipiscing.</h6>
                  </div>
              </div>
              <!-- End of row -->

                <!-- Start of row -->
                <div class="row  mt-5 mb-3">
                    <div class="col-md-8">
                    </div>


                    <div class="col-md-4 align-self-center text-right">
                        <a href="#" class="btn btn-icon btn-main btn-effect">
                            view all
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    </div>
                </div>
                <!-- End of row -->


                <!-- Start of Latest Movies Slider -->
                <div class="row owl-carousel latest-posts-slider mt-20">

                    <!-- === Start of Sliding Item 1 === -->
                    <%@posts.each do |post|%>
                      <div>
                        <div class="movie-box-3 shadow mb30">
                          <div class="listing-container">

                            <!-- Movie List Image -->
                            <div class="listing-image">
                              <%if post.poster_image.attached?%>
                                <%= image_tag post.poster_image.variant(gravity:'Center',resize:"350x518^"  , crop: '350x518+0+0')%>
                              <%end%>
                            </div>

                            <!-- Movie List Content -->
                            <div class="listing-content border-top">
                              <div class="inner">

                                <!-- Play Button -->
                                <div class="play-btn">
                                  <a class="play-video" href="<%=post.link%>">
                                    <i class="fas fa-link"></i>
                                  </a>
                                </div>

                                <h2 class="title"><%=post.name%></h2>

                                <!-- Rating -->
                                <div class="stars">
                                  <input class="rating-input" type="hidden" value="<%=post.rating%>" />
                                  <div class="rating"></div>

                                  <%if post.rating.class == String%>
                                    <div class="d-inline-flex">
                                      <h6 style="font-size:12px;" class="fas fa-star text-warning mr-2"></h6>
                                      <h6 style="font-size:12px;" class="text-dark"><%=post.rating%></h6>
                                    </div>  
                                  <%end%> 

                                  <% aux =  @post_categories.where(post_id: post.id)%>
                                  <span class="category text-dark pt-1"><strong><%=collect_categories_ids(aux)%></strong></span>

                                </div>

                                <p class="mt-1"><%=post.description%></p>

                                <%= link_to  admin_post_path(post.id), class: "btn btn-main btn-effect" do%>

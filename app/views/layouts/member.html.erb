                    </div>
                </div>
                <!-- End of row -->


                <!-- Start of Latest Movies Slider -->
                <div class="row owl-carousel latest-movies-slider mt-20">

                    <!-- === Start of Sliding Item 1 === -->
                        <% @posts.each do |post|%>    
                            <div class="item">
                                <!-- Start of Movie Box -->
                                <div class="movie-box-1">

                                    <!-- Start of Poster -->
                                    <div class="poster">
                                        <%if post.poster_image.attached?%>
                                            <%= image_tag post.poster_image.variant(gravity:'Center',resize:"265x395^"  , crop: '265x395+0+0')%>
                                        <%end%>
                                    </div>
                                    <!-- End of Poster -->

                                    <!-- Start of Buttons -->
                                    <div class="buttons">
                                        <a class="play-video" href="https://www.youtube.com/watch?v=<%=post.link%>">
                                            <i class="fas fa-play"></i>
                                        </a>
                                    </div>
                                    <!-- End of Buttons -->

                                    <!-- Start of Movie Details -->
                                    <div class="movie-details">
                                        <h4 class="movie-title">
                                            <a href="movie-detail.html"><%= post.name %></a>
                                        </h4>
                                        <span class="released"><%= post.created_at %></span>
                                    </div>
                                    <!-- End of Movie Details -->

                                    <!-- Start of Rating -->
                                    <div class="stars">
                                        <div class="rating">
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="far fa-star"></i>
                                        </div>
                                        <%if post.votes > 0 %>
                                            <span><%=post.rating%>/ 10</span>
                                        <% elsif %>
                                            <span>Não há avaliações</span>
                                        <%end%>    
                                    </div>
                                    <!-- End of Rating -->

                                </div>
                                <!-- End of Movie Box -->
                            </div>
                        <%end%>

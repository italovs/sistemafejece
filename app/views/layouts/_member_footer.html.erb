    }

</style>


<!-- =============== START OF FOOTER =============== -->
<footer class="footer1 bg-dark">

    <!-- ===== START OF FOOTER WIDGET AREA ===== -->
    <div style="background-color: #018c77 !important;" class="footer-widget-area ptb60">
        <div class="container">
            <div class="row">

                <!-- Start of Widget 1 -->
                <div class="col-lg-4 col-md-5 col-sm-12 d-flex">
                    <div class="widget widget-about" style="margin-top: -15px;">

                        <!-- INSERT YOUR WHITE LOGO HERE -->
                        <div class="d-flex text-center d-flex justify-content-center">
                            <img class="m-0" src="https://storage.googleapis.com/farol-fejece/Logotipo%20Plataforma%20Farol/SVG/farol_Logo%20branca%20sem%20palavra%20embaixo.svg" alt="white logo" style="height: 140px;" class="logo-white">
                        </div>

                        <!-- Start of Widget 4 -->
                        <div class="widget widget-social">
                            <h4 class="widget-title text-center m-3">Siga-nos!</h4>

                            <p class="text-center"> Não fique por fora do que está rolando no MEJ Cearense!</p>

                            <!-- Start of Social Buttons -->
                            <ul class="social-btns text-center">
                                <!-- Social Media -->
                                <li>
                                    <a href="https://www.facebook.com/fejece" class="social-btn-roll facebook">
                                        <div class="social-btn-roll-icons">
                                            <i class="social-btn-roll-icon fab fa-facebook"></i>
                                            <i class="social-btn-roll-icon fab fa-facebook bg-white text-f-green"></i>
                                        </div>
                                    </a>
                                </li>

                                <!-- Social Media -->
                                <li>
                                    <a href="https://www.linkedin.com/company/fejece/" class="social-btn-roll linkedin">
                                        <div class="social-btn-roll-icons">
                                            <i class="social-btn-roll-icon fab fa-linkedin-in"></i>
                                            <i class="social-btn-roll-icon fab fa-linkedin-in bg-white text-f-green"></i>
                                        </div>
                                    </a>
                                </li>
                                
                                <!-- Social Media -->
                                <li>
                                    <a href="https://www.instagram.com/fejece/" class="social-btn-roll instagram">
                                        <div class="social-btn-roll-icons">
                                            <i class="social-btn-roll-icon fab fa-instagram"></i>
                                            <i class="social-btn-roll-icon fab fa-instagram bg-white text-f-green"></i>
                                        </div>
                                    </a>
                                </li>

                                <!-- Social Media -->
                                <li>
                                    <a href="https://twitter.com/FEJECE" class="social-btn-roll twitter">
                                        <div class="social-btn-roll-icons">
                                            <i class="social-btn-roll-icon fas fa-globe-americas"></i>
                                            <i class="social-btn-roll-icon fas fa-globe-americas bg-white text-f-green"></i>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                            <!-- End of Social Buttons -->
                        </div>
                        <!-- End of Widget 4 -->
                    
                    </div>

                </div>
                <!-- End of Widget 1 -->

                <div class="col-lg-4 col-md-1 pb-5 px-2 ">

                    <h4 class="text-center text-white mt-0" style="margin-bottom: 40px">Entre em Contato!</h4>

                    <input type="text" placeholder="Telefone" id="form_phone" class="mb-3">
                    <textarea placeholder="Mensagem" rows="5" id="form_message" class="mb-3"></textarea>

                    <a class="btn-f-orange rounded text-white px-3 py-2" id="submit_form_button" type="button" style="display: none;">
                        <strong>Enviar</strong>
                    </a>

                    <a class="btn-f-orange rounded text-white px-3 py-2" id="fake_form_button" type="button">
                        <strong>Enviar</strong>
                    </a> 
            
                </div>

                <!-- Start of Widget 2 -->
                <div class="col-lg-3 col-md-6 col-sm-12 justify-content-center">
                    <div class="widget widget-links">
                        <h4 class="widget-title text-center">Vídeos recentes</h4>

                        <% @footer_videos.first(3).each do |post| %>
                            <ul class="recent-posts pl-1">
                                <li style="list-style: none;">
                                    <article class="post-format-standard row justify-content-center mb-3">
                                        <div class="mini-post-imgb w-auto float-left">
                                            <a class="alignleft post-rollover this-ready" aria-label="redimensionar imagens">
                                                <%if post.poster_image.attached?%>
                                                    <%= image_tag post.poster_image.variant(gravity:'Center',resize:"80x60^"  , crop: '80x60+0+0')%>
                                                <%end%>
                                            </a>
                                        </div>

                                        <div class="post-content w-auto p-0">
                                            <%= link_to current_user_post_path(post.id) do%>
                                                
                                                    <span class="row">
                                                        <p style="font-size: 18px; margin-bottom: 0px;"><%= post.name.length <= 60?  post.name : post.name[0..59] + "..." %></p>
                                                    </span>
                                                    <span class="row">
                                                        <p style="font-size: 12px;"><%= post.description.length <= 350? post.description : post.description[0..349] + "..." %></p>
                                                    </span>

                                            <%end%>
                                        </div>
                                    </article>
                                </li>
                            </ul>
                        <%end%>
                    
                    </div>
                </div>

                <!-- End of Widget 2 -->


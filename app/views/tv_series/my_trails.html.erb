<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<%= csrf_meta_tags %>
	<%= csp_meta_tag %>
	<title>Meu Canal</title>
	<!-- ===== Mobile viewport optimized ===== -->
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0,maximum-scale=1.0, user-scalable=no">

	<!-- ===== Meta Tags - Description for Search Engine purposes ===== -->
	<meta name="description" content="Movify - Movies, Series & Cinema HTML Template">
	<meta name="keywords" content="movies, series, online streaming, html template, cinema html template">
	<meta name="author" content="GnoDesign">
	<meta name="turbolinks-visit-control" content="reload">

	<%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
	

	<!-- ===== Favicon & Different size apple touch icons ===== -->
	<link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon">
	<link rel="apple-touch-icon" sizes="57x57" href="assets/images/apple-touch-icon-iphone.png">
	<link rel="apple-touch-icon" sizes="76x76" href="assets/images/apple-touch-icon-ipad.png">
	<link rel="apple-touch-icon" sizes="120x120" href="assets/images/apple-touch-icon-iphone-retina.png">
	<link rel="apple-touch-icon" sizes="152x152" href="assets/images/apple-touch-icon-ipad-retina.png">
	<link rel="apple-touch-icon" sizes="167x167" href="assets/images/apple-touch-icon-ipad-pro.png">
	<link rel="apple-touch-icon" sizes="180x180" href="assets/images/apple-touch-icon-iphone-6-plus.png">
	<link rel="icon" sizes="192x192" href="assets/images/icon-hd.png">
	<link rel="icon" sizes="128x128" href="assets/images/icon.png">

	<!-- ===== Google Fonts ===== -->
	<link href="https://fonts.googleapis.com/css?family=Quicksand:300,400,500,700" rel="stylesheet">
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
	<link href="https://use.fontawesome.com/releases/v5.15.2/css/all.css" rel="stylesheet">

	<!-- ===== CSS links ===== -->
	<%= stylesheet_link_tag 'application', media: 'all' %>
	<%= stylesheet_link_tag 'bootstrap.min', media: 'all' %>
	<%= stylesheet_link_tag 'revolution/css/settings', media: 'all' %>
	<%= stylesheet_link_tag 'revolution/css/layers', media: 'all' %>
	<%= stylesheet_link_tag 'revolution/css/navigation', media: 'all' %>
	<%= stylesheet_link_tag 'magnific-popup', media: 'all' %>
	<%= stylesheet_link_tag 'jquery.mmenu', media: 'all' %>
	<%= stylesheet_link_tag 'owl.carousel.min', media: 'all' %>
	<%= stylesheet_link_tag 'style', media: 'all' %>
	<%= stylesheet_link_tag 'responsive', media: 'all' %>
	<%= stylesheet_link_tag 'assets/jqueryui.min.css', media: 'all' %>
	<%= stylesheet_link_tag 'assets/datatables.min.css', media: 'all' %>

</head>

<style>
	.mm-slideout{
		z-index: 9999;
	}

	#main-mobile-nav{
		z-index: 9999;
	}

	.header{
		background: trasnparent !important;
	}

	.overlay-gradient .slotholder:after,
	.overlay-gradient:after {
		opacity:1.0 !important;
	}

	a:visited {
		color: #fff; }

	.overlay-gradient .slotholder:after,
	.overlay-gradient:after,
	.blog-post .blog-thumb a:before,
	ul.blog-posts-widget .blog-content .blog-thumb a:before,
	.celebrity-list-1 .celebrity-image a:before,
	.celebrity-grid-1 .celebrity-image a:before,
	.bloglist-post-holder .bloglist-thumb-link .bloglist-post-thumbnail:after,
	.movie-box-1 .poster:before,
	.movie-detail-intro2 .movie-poster:before {
			background: -webkit-gradient(linear, left top, left bottom, from(#018c77), to(#e27321));
			background: -webkit-linear-gradient(bottom, #e27321 20%, #018c77 100%);
			background: -o-linear-gradient(bottom, #e27321 20%, #018c77 100%);
			background: linear-gradient(to bottom, #018c77 20%, #e27321 100%);
	}

	td{
		display: none;
		border-style: none;
	}

</style>

<body class="bg-light">
	<nav id="main-mobile-nav"></nav>
	<%= render '/layouts/member_navbar' %>
	<%= yield %>
	
	<section class="page-header overlay-gradient" style="
    z-index: 0;">
		<div class="container">
				<div class="inner py-4">
						<h2 class="title pb-1">Minhas Trilhas</h2>
						<ol class="breadcrumb">
								<li><%=link_to "Home", logged_root, class:"text-white" %></li>
								<li>Minhas Trilhas</li>
						</ol>
				</div>
		</div>
	</section>

	<br/><br/><br/>

	<div class="container p-0">
		<div class="row">
			<div class="col d-flex justify-content-end">
				<div id="new_serie" class="btn btn-f-green text-white">
					Nova Série
				</div>
			</div>
		</div>	

		<br/><br/><br/>


		<table id="series_list" class="container series-row mx-auto p-0 border-0", data-page-length='2'>
			
			<thead>
				<tr>
					<th class="border-0"></th>
				</tr>
			</thead>

			<tbody>
				<% @series.each do |serie| %>
					<tr>
						<th class="border-0">
							<div class="col-md-12 col-sm-12 p-0">
								<div class="watch-later-item">
									<div class="listing-container">

										<!-- Movie List Image -->
										<div class="listing-image">
											<%if serie.poster_image.attached?%>
												<%= image_tag serie.poster_image.variant(gravity:'Center',resize:"530x300^"  , crop: '530x300+0+0')%>
											<%end%>
										</div>

										<!-- Movie List Content -->
										<div class="listing-content">
											<div class="inner">
												<h3 class="title" style="color: #000;"><%= serie.name %></h3>

												<% aux =  @serie_categories.where(tv_serie_id: serie.id)%>
												<p style="color: #3d4555;"><%= serie.description %></p>

												<div class="row">
													<div class="col">
														<%= link_to current_user_serie_path(serie.id), class: 'btn btn-main btn-effect' do%>
															Assistir
														<% end %>
													</div>	

													<div class="col d-flex justify-content-end">
														<li class="tooltips nav-link btn btn-primary mr-2 edit_serie" type="button" value="<%=serie.id%>" title="Editar" data-placement="bottom" style="width:50px;">
															<i class="fas fa-pencil-alt"></i>
														</li>

														<li class="tooltips nav-link btn btn-danger delete_serie" type="button" value="<%=serie.id%>" title="Deletar" data-placement="bottom" style="width:50px;">
															<i class="fas fa-trash-alt"></i>
														</li>
													</div>
												</div>	
												
											</div>
										</div>

									</div>
								</div>
							</div>
						</th>
					</tr>		
				<% end %>
					
			</tbody>		
		</table>

		<div id="form-fields">
			<div class="row justify-content-center">
				<div class="col-lg-8">
					<div class="card card-small mb-4">
						<div class="card-header border-bottom bg-f-green">
							<h6 id="main_title" class="m-0 text-white">Nova Série</h6>
						</div>
						<ul class="list-group list-group-flush">
							<li class="list-group-item p-3">
								<div class="row">
									<div class="col">
										<form>
											<div class="form-row serie-field">
												<div class="form-group col-md-12">
													<%= text_field_tag :serie_name, nil, placeholder: "Nome da Série", class: "input_field form-control"%>
												</div>
											</div>

											<div class="form-row serie-field">
												<div class="form-group col-md-12">
													<p class="text-muted d-block mb-2 d-inline-flex">Poster da série</p>
													<small class= "form-text text-muted d-inline-flex" style="font-size: 12px !important">tamanho recomendado 300x444|tamanho máximo 5 mb</small>
													<%= file_field_tag :poster_image, title: "poster da publicação", class: "input_field form-control", id:"serie_poster_image", accept:"image/jpg, image/png, image/jpeg"%>
												</div>
											</div>

											<div class="form-row serie-field">
												<div class="form-group col-md-12">
													<p class="text-muted d-block mb-2 d-inline-flex">Banner da série</p>
													<small class= "form-text text-muted d-inline-flex" style="font-size: 12px !important">tamanho recomendado 1600x803|tamanho máximo 5 mb</small>
													<%= file_field_tag :banner_image, placeholder: "Banner da publicação", class: "input_field form-control", id:"serie_banner_image", accept:"image/jpg, image/png, image/jpeg" %>
												</div>
											</div>

											<div class="form-row serie-field">
												<div class="form-group col-md-12">
													<p class="text-muted d-block mb-2">Categorias</p>
													<%= select_tag :tv_series_category, options_from_collection_for_select(Category.all,'id','name'),{class: 'select_field custom-select form-control selectize mb-3', style: "height:100%;",multiple: true}%>
												</div>
											</div>

											<div class="form-row serie-field" id="seasons">
												<div class="form-group col-md-10" style="display: inline-flex">
													<p class="text-muted d-block mb-auto mt-auto mr-2">Temporada:</p>
													<div class="input-group">
  														<select class="custom-select h-100" id="season-select">
  														</select>
  														<div class="input-group-append">
    														<button id="new_season" type="button" class="btn btn-f-green text-white mb-2 ml-auto h-100">Nova Temporada</button>
															<button id="delete-season" type="button" class="btn btn-danger text-white mb-2 ml-auto h-100" >
																<i class="fas fa-trash-alt" style="font-size: 18px;"></i>
															</button>
  														</div>
													</div>
												</div>
											

												<div class="form-row serie-field col-md-12">
													<div id="seasons" class="form-group col-md-12">
														<p class="text-muted d-block mb-2">Escolher as Publicações</p>
														<%= select_tag :seasons_post, options_from_collection_for_select(@all_posts,'id','name', 'poster_image'), {class: 'select_field custom-select form-control selectize mb-3', style: "height:100%; display:grid;", multiple: true} %>
													</div>	
												</div>	
											</div>
											

											<div class="form-row serie-field">
												<div class="form-group col-md-12">
													<%= text_area_tag :serie_description, nil, placeholder: "Descrição", class: "input_field form-control", rows:"5" %>
												</div>
											</div>

											<div id="create_new_serie" class="btn btn-f-green text-white">
												Criar
											</div>

											<input id="update_input" type="hidden" value="" />

											<div id="update_serie" class="btn btn-f-green text-white">
												Atualizar
											</div>
										</form>
									</div>
								</div>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>	

	<br/><br/><br/><br />
	<br/><br/>
	<%= render '/layouts/member_footer' %>

	<input id="aux-input" type="hidden" value="" />


	<%= javascript_include_tag 'essencials', 'data-turbolinks-track': 'reload'%>
	<%= javascript_include_tag 'assets/datatables.min.js', 'data-turbolinks-track': 'reload', :defer=>"defer" %>
	<%= javascript_include_tag 'my_trails', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'pagination_evaluation', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'jquery-3.2.1.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'bootstrap.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'jquery.ajaxchimp', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'jquery.magnific-popup.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'jquery.mmenu', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'jquery.inview.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'jquery.countTo.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'jquery.countdown.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'assets/jqueryui.min.js', 'data-turbolinks-track': 'reload', :defer => "defer"%>
	<%= javascript_include_tag 'owl.carousel.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'imagesloaded.pkgd.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'isotope.pkgd.min', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'headroom', 'data-turbolinks-track': 'reload' %>
	<%= javascript_include_tag 'custom', 'data-turbolinks-track': 'reload' %>
</body>
</html>

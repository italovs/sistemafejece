<p>Olá<%= @email %>!</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>Nós estamos entrando em contato para informar que seu email está sendo alterado para <%= @resource.unconfirmed_email %>.</p>
<% else %>
  <p>Nós estamos entrando em contato para notificar que seu email foi alterado para <%= @resource.email %>.</p>
<% end %>

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <%# TODO: colocar um título %>
    <title>Farol - Registro</title>
    <%# TODO: mudar com descrição do sistema %>
    <meta name="description" content="Mudar com a descrição do sistema.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
</head>




<body>

  <style>
    body{
        background: rgb(216,117,46);
        background: linear-gradient(145deg, rgba(216,117,46,1) 40%, rgba(1,140,119,1) 60%);
        background-repeat: no-repeat;
        height: 140%;
      }
  </style>
  
  <main class="main-content col">
    <div class="main-content-container container-fluid px4">
      <div class="row no gutters h-100">
        <div class="col-lg-5 col-md-5 auth-form mx-auto mt-3">
          <div class="card">
            <div class="card-body">
              <img class="auth-form__logo d-table mx-auto mb-3" src="/images/fejece_logo_fundo_branco.jpg" alt="Logo FEJECE">
              <h5 class="auth-form__title text-center mb-4">Crie sua conta</h5>
              <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
                <%= render "devise/shared/error_messages", resource: resource %>
                <%= notice || alert%>

                <div class="form-group">
                  <label for="exampleInputEmail1">Nome completo</label>
                  <%= f.text_field :name, autofocus: true, autocomplete: "name", class:"form-control" %>
                </div>

                <div class="form-group">
                  <label for="exampleInputEmail1">Email</label>
                  <%= f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control" %>
                </div>

                <div class="form-group">
                  <label>Escolha sua empresa júnior</label>
                  <%= collection_select(:member,:junior_enterprise_id, JuniorEnterprise.all.where.not(id: 0).order(:name) ,:id,:name, {},{:class =>'form-control custom-select custom-select-sm'})%>
                </div>
                <div class="form-group">
                  <label>Qual o seu cargo?</label>
                  <%= f.select :position, Member.positions.keys ,{},{class:'form-control custom-select custom-select-sm'}%>
                </div>
                <div class="form-group">
                  <label>Senha</label>
                  <% if @minimum_password_length %>
                  <em>(<%= @minimum_password_length %> caracteres pelo menos)</em>
                  <% end %><br />
                  <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
                </div>

                <div class="form-group">
                  <label>Confirme sua senha</label>
                  <%= f.password_field :password_confirmation, autocomplete: "Confirme a senha",class:"form-control" %>
                </div>

                <div class="form-group">
                  <h6 id="warn-text" style="display:none; font-size:14px; color:#CC0000;">É preciso aceitar os termos de uso</h6>
                  <input type="checkbox" class="custom-control-input d-inline" id="accept_informations" name="admin[remember_me]">
                  <label class="custom-control-label d-inline" for="customCheck2">Aceito os Termos de Uso</label>
                </div>  

                <div class="actions">
                  <%= f.submit "Cadastrar", class:"mb-2 btn btn-sm btn-pill btn-f-orange text-white mr-2", id: 'submit-button-1',  style:'display: none;' %>
                  <input value="Cadastrar" style="width: 78.3px;" id="submit-button-2" name="commit" 
                          type="button" class="mb-2 btn btn-sm btn-pill btn-f-orange text-white mr-2" data-disable-with="Cadastrar">
                </div>

                <%= render "devise/shared/links" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

    <% end %>

    <%= javascript_include_tag 'registration.js' %>

</body>
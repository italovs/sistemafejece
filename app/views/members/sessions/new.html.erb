
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <%# TODO: colocar um título %>
    <title>App Exemplo</title>
    <%# TODO: mudar com descrição do sistema %>
    <meta name="description" content="Mudar com a descrição do sistema.">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
</head>

<body>

  <div class="col-lg-5 col-md-5 auth-form mx-auto mt-3">
    <div class="card">
      <div class="card-body">
        <img class="auth-form__logo d-table mx-auto mb-3" src="/images/fejece_logo_fundo_branco.jpg" alt="Logo FEJECE">
        <h5 class="auth-form__title text-center mb-4">Acesse sua Conta</h5>
        <%= form_with(model: @member, url: member_session_path) do |f| %>
          <div class="form-group">
            <label for="exampleInputEmail1">Email</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Email" %>
          </div>
          <div class="form-group">
            <label for="exampleInputPassword1">Senha</label>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Senha" %>
          </div>
          <div class="form-group mb-3 d-table mx-auto" >
            <div class="custom-control custom-checkbox mb-1">
              <% if devise_mapping.rememberable? %>
                <div class="field">
                  <input type="checkbox" class="custom-control-input" id="customCheck2" name="admin[remember_me]" style="margin-right:10px">
                  <label class="custom-control-label" for="customCheck2">Lembre de mim</label>
                </div>
              <% end %>
            </div>
          </div>
          <%= f.submit "Entrar", class: "btn btn-pill btn-accent d-table mx-auto" %>
        <% end %>
      </div>

        <div class="card-footer border-top">
          <div class="row">
            <div class="col-6">
              <%= render "devise/shared/links" %>
            </div>
            <div class="col-6 d-flex justify-content-end">
              <%= link_to "Logar como admin", new_admin_session_path%>
            </div>
          </div>  
        </div>
    </div>
    
  </div>
<div class="col-lg-3 col-md-5 auth-form mx-auto mt-3">
  <div class="card">
    <div class="card-body">
      <img class="auth-form__logo d-table mx-auto mb-3" src="/images/fejece_logo_fundo_branco.jpg" alt="Logo FEJECE">
      <h5 class="auth-form__title text-center mb-4">Esqueceu sua Senha?</h5>
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div class="form-group">
          <label for="exampleInputEmail1">Email</label>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Email" %>
        </div>
        
        <%= f.submit "Envie-me instruções para renovar a senha", class: "btn btn-pill btn-accent d-table mx-auto" %>
      <% end %>
    </div>
  </div>
  <div class="auth-form__meta d-flex mt-4">
    <%= render "devise/shared/links" %>
  </div>
</div>
Seus Dados
<br>
<br>

<div class="field" id="profile_info">
	<strong>
		Nome: 
	</strong>
	<span id="name"><%= @profile.name.nil? ? "Não informado" : @profile.name %></span>
</div>
<div class="field">
	<strong>
		E-mail: 
	</strong>
	<span id="email"><%= @profile.email %></span>
</div>
<div class="field">
	<strong>
		Sobre: 
	</strong>
	<span id="about"><%= @profile.about.nil? ? "Não informado" : @profile.about %></span>
</div>
<% if member_signed_in? %>
	<div class="field">
		<b>
		Empresa Júnior: 
		</b>
		<span id="junior_enterprise"><%= @profile.junior_enterprise.nil? ? "Não informado" : @profile.junior_enterprise.name %></span>
	</div>
	<div class="field">
		<strong>
		Cargo: 
		</strong>
		<span id="position"><%= @profile.position.nil? ? "Não informado" : @profile.position %></span>
	</div>
	<div class="field">
		<strong>
		Status: 
		</strong>
		<span id="validated"><%= @profile.validated.nil? ? "Diretoria Solicitada" : (@profile.validated? ? "Membro Diretor" : "Membro" ) %></span>
	</div>
<% end %>

<br>
<br>


<div class="field profile_data">
	<%= text_field_tag :field_name, nil, placeholder: "Nome", class: "input_field", value: @profile.try(:name) %>
</div>

<div class="field profile_data">
	<%= text_area_tag :field_about, nil, placeholder: "Descrição", class: "input_field", value: @profile.try(:description) %>
</div>

<div class="field profile_data email">
	<%= text_field_tag :new_email, nil, placeholder: "Email", class: "input_field", value: @profile.email %>
</div>

<div class="field profile_data email">
	<%= text_field_tag :repeat_email, nil, placeholder: "Repetir Email", class: "input_field"  %>
</div>

<div class="field password">
	<%= password_field_tag :old_password, nil, placeholder: "Senha Atual", class: "input_field" %>
</div>

<div class="field password">
	<%= password_field_tag :new_password, nil, placeholder: "Nova Senha", class: "input_field" %>
</div>

<div class="field password">
	<%= password_field_tag :confirmation_password, nil, placeholder: "Repetir Nova Senha", class: "input_field" %>
</div>

<div id="edit" class="btn btn-primary">
	Modificar Informações
</div>

<% if member_signed_in? && current_member.validated == false %>
	<div id="director" class="btn btn-primary">
		Solicitar Diretoria
	</div>
<% end %>

<div id="change_mail" class="btn btn-primary">
	Mudar E-mail
</div>

<div id="change_password" class="btn btn-primary">
	Nova Senha
</div>


<script src="<%= javascript_path "essencials" %>"></script>
<script src="<%= javascript_path "profile" %>"></script>
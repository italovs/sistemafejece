<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- ===== Mobile viewport optimized ===== -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0,maximum-scale=1.0, user-scalable=no">

    <!-- ===== Meta Tags - Description for Search Engine purposes ===== -->
    <meta name="description" content="Movify - Movies, Series & Cinema HTML Template">
    <meta name="keywords" content="movies, series, online streaming, html template, cinema html template">
    <meta name="author" content="GnoDesign">
    <meta name="turbolinks-visit-control" content="reload">

    
    <%= javascript_include_tag 'administrative', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'application', media: 'all' %>

    <!-- ===== Favicon & Different size apple touch icons ===== -->
    <link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="57x57" href="assets/images/apple-touch-icon-iphone.png">
    <link rel="apple-touch-icon" sizes="76x76" href="assets/images/apple-touch-icon-ipad.png">
    <link rel="apple-touch-icon" sizes="120x120" href="assets/images/apple-touch-icon-iphone-retina.png">
    <link rel="apple-touch-icon" sizes="152x152" href="assets/images/apple-touch-icon-ipad-retina.png">
    <link rel="apple-touch-icon" sizes="167x167" href="assets/images/apple-touch-icon-ipad-pro.png">
    <link rel="apple-touch-icon" sizes="180x180" href="assets/images/apple-touch-icon-iphone-6-plus.png">
    <link rel="icon" sizes="192x192" href="assets/images/icon-hd.png">
    <link rel="icon" sizes="128x128" href="assets/images/icon.png">

    <!-- ===== Google Fonts ===== -->
    <link href="https://fonts.googleapis.com/css?family=Quicksand:300,400,500,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://use.fontawesome.com/releases/v5.15.2/css/all.css" rel="stylesheet">
      

    <!-- ===== CSS links ===== -->
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= stylesheet_link_tag 'bootstrap.min', media: 'all' %>
    <%= stylesheet_link_tag 'revolution/css/settings', media: 'all' %>
    <%= stylesheet_link_tag 'revolution/css/layers', media: 'all' %>
    <%= stylesheet_link_tag 'revolution/css/navigation', media: 'all' %>
    <%= stylesheet_link_tag 'magnific-popup', media: 'all' %>
    <%= stylesheet_link_tag 'jquery.mmenu', media: 'all' %>
    <%= stylesheet_link_tag 'owl.carousel.min', media: 'all' %>
    <%= stylesheet_link_tag 'style', media: 'all' %>
    <%= stylesheet_link_tag 'responsive', media: 'all' %>
    <title>Meu Canal</title>
  </head>

  <style>
    .mm-slideout{
      z-index: 99;
    }

    #main-mobile-nav{
      z-index: 2
    }

    .header{
      background: trasnparent !important;
    }

    .overlay-gradient .slotholder:after,
    .overlay-gradient:after {
      opacity:1.0 !important;
    }  

    a:visited {
      color: #fff; }

    .overlay-gradient .slotholder:after,
    .overlay-gradient:after,
    .blog-post .blog-thumb a:before,
    ul.blog-posts-widget .blog-content .blog-thumb a:before,
    .celebrity-list-1 .celebrity-image a:before,
    .celebrity-grid-1 .celebrity-image a:before,
    .bloglist-post-holder .bloglist-thumb-link .bloglist-post-thumbnail:after,
    .movie-box-1 .poster:before,
    .movie-detail-intro2 .movie-poster:before {
        background: -webkit-gradient(linear, left top, left bottom, from(#018c77), to(#e27321));
        background: -webkit-linear-gradient(bottom, #e27321 20%, #018c77 100%);
        background: -o-linear-gradient(bottom, #e27321 20%, #018c77 100%);
        background: linear-gradient(to bottom, #018c77 20%, #e27321 100%);
    }

  </style>

  <body class="bg-light">
    
    <nav id="main-mobile-nav"></nav>
    <%= render '/layouts/member_navbar' %>
    <%= yield %>

    <section class="page-header overlay-gradient">
      <div class="container">
          <div class="inner py-4">
              <h2 class="title pb-1"><%= @serie.name %></h2>
              <ol class="breadcrumb">
                  <li><%=link_to "Home", admin_root_path, class:"text-white" %></li>
                  <li><%= @serie.name %></li>
              </ol>
          </div>
      </div>
    </section>

    <br/><br/><br/>


    <div class="d-flex justify-content-end">
      <div id="video" class="btn btn-f-green text-white mr-2">
        Vídeos
      </div>

      <div id="post" class="btn btn-f-green text-white mr-4">
        Posts
      </div>
    </div>  

    <br/><br/><br/>

    <div class="videos-row" style="margin:0 5%">
      <%cont = 0%>
      <% @videos.each do |post| %>
        <%cont += 1%>
        <div class="col-md-12 col-sm-12 var-item" value="<%=cont%>">
          <div class="movie-list-1 mb30">
              <div class="listing-container">

                  <!-- Movie List Image -->
                  <div class="listing-image">
                    <%if post.poster_image.attached?%>
                      <%= image_tag post.poster_image.variant(gravity:'Center',resize:"530x300^"  , crop: '530x300+0+0')%>
                    <%end%>

                      <!-- Play Button -->
                      <div class="play-btn">
                          <a href="https://www.youtube.com/watch?v=<%= post.link %>" class="play-video">
                            <i class="fas fa-play"></i>
                          </a>
                      </div>

                      <!-- Buttons -->
                      <div class="buttons">
                          <a href="#" data-original-title="Rate" data-toggle="tooltip" data-placement="bottom">
                              <i class="fas fa-heart"></i>
                          </a>

                          <a href="#" data-original-title="Share" data-toggle="tooltip" data-placement="bottom">
                            <i class="fas fa-share-alt"></i>
                          </a>
                      </div>

                      <!-- Rating -->
                      <div class="stars">
                          <input class="rating-input" type="hidden" value="<%=post.rating%>" />
                          <div class="rating"></div>

                          <%if post.rating.class == String%>
                            <div class="d-inline-flex">
                              <h6 class="fas fa-star text-warning mr-2"></h6>
                              <h6 class="text-white"><%=post.rating%></h6>
                            </div>  
                          <%end%>
                      </div>

                      <!-- Image -->
                      <img src="" alt="">
                  </div>

                  <!-- Movie List Content -->
                  <div class="listing-content">
                      <div class="inner">
                          <h2 class="title"><%= post.name %></h2>

                          <p><%=post.description%></p>

                          <%= link_to  admin_post_path(post.id), class: "btn btn-main btn-effect" do%>
                              Detlhes
                          <%end%>
                      </div>
                  </div>

              </div>
          </div>
        </div>
      <%end%>
    </div>

    <div class="paginate-container videos-row">
      <nav>
        <ul class="paginate d-flex justify-content-center">
          <% i = 1 %>
          <% while (i <= (cont.to_f/2).ceil) %>
            <button class="paginate-item page-link d-inline" value="<%= i%>"><%=i%></button>
            <%i += 1%>
          <%end%>
        </ul>
      </nav>
    </div>

    
    <main class="ptb100 posts-row">
      <div class="container">
        <div class="row">
          <!-- Movie List Item -->
          <%cont = 0%>
          <%@posts.each do |post|%>
            <%cont += 1%>
            <div class="col-lg-4 col-md-6 col-sm-12 var-item", value="<%=cont%>">
              <div class="movie-box-3 mb30">
                <div class="listing-container">

                  <!-- Movie List Image -->
                  <div class="listing-image">
                    <%if post.poster_image.attached?%>
                      <%= image_tag post.poster_image.variant(gravity:'Center',resize:"350x518^"  , crop: '350x518+0+0')%>
                    <%end%>
                  </div>

                  <!-- Movie List Content -->
                  <div class="listing-content border-top">
                    <div class="inner">

                      <!-- Play Button -->
                      <div class="play-btn">
                        <a class="play-video" href="<%=post.link%>">
                          <i class="fas fa-link"></i>
                        </a>
                      </div>

                      <h2 class="title"><%=post.name%></h2>

                      <!-- Rating -->
                      <div class="stars">
                        <%#byebug%>
                        <input class="rating-input" type="hidden" value="<%=post.rating%>" />
                        <div class="rating"></div>

                        <%if post.rating.class == String%>
                          <div class="d-inline-flex">
                            <h6 class="fas fa-star text-warning mr-2"></h6>
                            <h6 class="text-secondary"><%=post.rating%></h6>
                          </div>  
                        <%end%> 

                        <span class="category"><%=post.post_category%></span>

                      </div>

                      <p><%=post.description%></p>

                      <%= link_to  admin_post_path(post.id), class: "btn btn-main btn-effect" do%>
                          Detlhes
                      <%end%>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          <%end%>
        </div>
      </div>
    </main>

    <div class="paginate-container posts-row">
      <nav>
        <ul class="paginate d-flex justify-content-center">
          <% i = 1 %>
          <% while (i <= (cont.to_f/2).ceil) %>
            <button class="paginate-item page-link d-inline" value="<%= i%>"><%=i%></button>
            <%i += 1%>
          <%end%>
        </ul>
      </nav>
    </div>
    
      

    <br/><br/><br/><br />

    <br/><br/>

    <%= render '/layouts/member_footer' %>

    
    <%= javascript_include_tag 'serie', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'pagination_evaluation', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery-3.2.1.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'bootstrap.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.ajaxchimp', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.magnific-popup.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.mmenu', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.inview.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.countTo.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'jquery.countdown.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'owl.carousel.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'imagesloaded.pkgd.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'isotope.pkgd.min', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'headroom', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'custom', 'data-turbolinks-track': 'reload' %>
  </body>  

<%if true == false%>
  <div id="new_video" class="btn btn-primary">Novo Vídeo</div>
  <div id="new_serie" class="btn btn-primary">Nova Série</div>
  <div id="series" class="btn btn-primary">Minhas Séries</div>
  <div id="videos" class="btn btn-primary">Meus Vídeos</div>


  <%# novo vídeo %>
  <%= text_field_tag :youtube_name, nil, placeholder: "Nome" %>
  <%= text_field_tag :youtube_description, nil, placeholder: "Descrição" %>
  <%= text_field_tag :youtube_link, nil, placeholder: "Link do Vídeo do YouTube" %>
  <%= select_tag :tv_series, options_from_collection_for_select(@tv_series, "id", "name"), {:include_blank => "Selecione"} %>
  <%= select_tag :season, options_for_select([ "Selecione", "1"])  %>
  <div id="create_new_video" class="btn btn-primary">CRIAR</div> 

  <%# nova série %>
  <%= text_field_tag :serie_name, nil, placeholder: "Nome da Série" %>
  <%= select_tag :tv_series_category, options_from_collection_for_select(@categories, "id", "name"), {:include_blank => "Selecione"} %>
  <div id="create_new_serie" class="btn btn-primary">CRIAR</div>

  <div id="my_series">
    
  </div>
<%end%>


<div style="margin: 0 5%;">
  <div class="row">
    <div class="col-lg-8">
      <div class="card card-small mb-4">
        <div class="card-header border-bottom bg-f-green">
          <h6 id="main_title" class="m-0 text-white">Detalhes do Perfil</h6>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item p-3">
            <div class="row">
              <div class="col">
                <form>

                  <div class="form-row video-field">
                    <div class="form-group col-md-12">
                      <%= text_field_tag :youtube_name, nil, placeholder: "Nome", class: "input_field form-control" %>
                    </div>  
                  </div>

                  <div class="form-row video-field">
                    <div class="form-group col-md-12">
                      <%= text_field_tag :youtube_link, nil, placeholder: "Link do Vídeo do YouTube", class: "input_field form-control" %>
                    </div>  
                  </div>

                  <div class="form-row video-field">
                    
                    <div class="form-group col-md-6">
                      <%= select_tag :season, options_for_select([ "Selecione", "1"]), {class: 'select_field custom-select form-control', style: "height:100%;"}  %>
                    </div>  
                  </div> 

                  <div class="form-row video-field">
                    <div class="form-group col-md-12">
                      <%= text_area_tag :youtube_description, nil, placeholder: "Descrição", class: "input_field form-control", rows:"5" %>
                    </div>  
                  </div>

                  <div class="form-row serie-field">
                    <div class="form-group col-md-12">
                      <%= text_field_tag :serie_name, nil, placeholder: "Nome da Série", class: "input_field form-control"%>
                    </div>  
                  </div>

                  <div class="form-row serie-field">
                    <div class="form-group col-md-12">
                      <%= select_tag :tv_series_category, options_from_collection_for_select(@categories, "id", "name"), {:include_blank => "Selecione",  :class => 'select_field custom-select form-control', :style => "height:100%;"} %>
                    </div>  
                  </div>
                  
                  <div id="create_new_video" class="btn btn-f-green text-white">
                    Criar
                  </div>

                  <div id="create_new_serie" class="btn btn-f-green text-white">
                    Criar
                  </div>

                  <div id="new_video" class="btn btn-f-green text-white">
                    Novo Vídeo
                  </div>

                  <div id="new_serie" class="btn btn-f-green text-white">
                    Nova Série
                  </div>

                  <div id="video" class="btn btn-f-green text-white">
                    Meus Vídeos
                  </div>

                  <div id="series" class="btn btn-f-green text-white">
                    Minhas Séries
                  </div>

                </form>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<%= javascript_include_tag 'my_channel.js' %>
